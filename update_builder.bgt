const string source="beerday.bgt", exe="beerday.exe", update="update.tmp", real="update.001", bgtpath="c:/program files (x86)/bgt/bgt.exe", exec=read_environment_variable("windir")+"/explorer.exe";
#include "build_constants.bgt"

void main()
{
show_game_window ("Beerday Update Builder");
if (question ("Uvedená verze je "+version, "V poøádku?") == 2) return;
if (question ("Build", "Verze: "+version+"\r\nDatum: "+build_day+". "+build_month+". "+build_year+", "+build_hour+":"+build_minute+"\r\nPokraèovat?") ==2) return;
if (question ("Zadat zprávu dne?", "") == 1) run (bgtpath, "motd.bgt", true, false);
if (question ("Zkontrolovat log?", "") == 1) run (exec, "bin\\changelog.html", true, false);
if (question ("Zkontrolovat roadmapu?", "") == 1) run (exec, "bin\\roadmap.html", true, false);
run (exec, "packer.bgt", true, false);
wait(500);
file f;
string command="";
if (question ("Smazat profil?", "")==1) command="c";
f.open ("bin/lastver.dat", "wb");
if (f.write (string_encrypt (version+"\t"+build_day+"\t"+build_month+"\t"+build_year+"\t"+build_hour+"\t"+build_minute+"\t"+command, scramble_update())) ==0) alert (get_last_error_text(), "");
f.close();
string compile="";
question("Zkompilovat jako release build?", "")==1?compile="-C":compile="-c";
run (bgtpath, compile+source, true, false);
file_copy (exe, "bin/"+exe, true);
file_copy (exe, update, true);
file_delete (exe);
file_encrypt (update, real, scramble_update());
file_delete (update);
file_copy (real, "bin\\"+real, true);
f.open ("bin/update.002", "wb");
if (f.write (string_encrypt (file_hash (real, 2, false), scramble_update())) ==0) alert (get_last_error_text(), "");
f.close();
file_delete (real);
f.open ("debugging.bgt", "rb");
string raw=f.read();
raw=string_replace (raw, "enable_debugging=true", "enable_debugging=false", true);
raw=string_replace (raw, "enable_logging=true", "enable_logging=false", true);
f.open ("debugging.bgt", "wb");
f.write (raw);
f.close();
if (question ("Uploadnout celý update?", "")==1)
{
run ("C:/Users/lukas/AppData/Local/Microsoft/WindowsApps/WinSCP.exe", "", false, false);
wait(1000);
}
}

bool instr (string source, string part)
{
if (source == "" or part == "") return false;
return string_contains (source, part, 1) > -1;
}