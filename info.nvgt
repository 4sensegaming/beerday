void say_fled()
{
string fc;
if (fled_total == 0)
{
fc="Nikdo neodešel";
if (hurt == 0) fc+=" ani neutekl kvůli zranění";
fc+=". ";
}
else if (fled_total>0)
{
uint8 happy=fled_total-fled;
if (fled_total == 1)
{
fc="Odešel jeden ";
if (happy==fled_total) fc+="spokojený ";
fc+="zákazník";
}
else if (fled_total < 5)
{
fc="Odešli "+fled_total+" ";
if (happy==fled_total) fc+="spokojení ";
fc+="zákazníci";
}
else
{
fc="Odešlo "+fled_total+" ";
if (happy==fled_total) fc+="spokojených ";
fc+="zákazníků";
}
fc+=". ";
if (happy>0 and happy!=fled_total)
{
if (happy==1) fc+="Jeden byl spokojený. ";
else if (happy<5) fc+=happy+" byli spokojení. ";
else fc+=happy+" bylo spokojených. ";
}
if (hurt>0)
{
if (hurt == 1) fc+="Jeden utekl";
else if (hurt < 5) fc+=hurt+" utekli";
else fc+=hurt+" uteklo";
fc+=" kvůli zranění. ";
}
}
uint8 now_fleeing=0, now_hurt=0, now_happy=0;
uint8 l=customers.length();
for (uint8 i=0; i<l; i++)
{
character@ h=@customers[i];
if ((h.state==fleeing or h.state==opening or h.state==closing) and h.leaving==1) now_fleeing++;
else if (h.leaving==2 or h.health<h.attack or h.health<difficulty) now_hurt++;
else if (h.leaving==3) now_happy++;
}
if (now_fleeing>0 or now_hurt>0 or now_happy>0)
{
fc+="Teď ";
if (now_fleeing == 0) fc+="nikdo ne";
else if (now_fleeing == 1)
{
fc+="jeden ";
if (now_happy==now_fleeing) fc+="spokojený ";
}
else if (now_fleeing>0 and now_fleeing<5)
{
fc+=now_fleeing+" ";
if (now_fleeing==now_happy) fc+="spokojení ";
}
else if (now_fleeing>0)
{
fc+=now_fleeing+" ";
if (now_happy==now_fleeing) fc+="spokojených ";
}
fc+="odchází a ";
if (now_hurt == 0) fc+="nikdo neutíká";
else if (now_hurt == 1) fc+="jeden utíká";
else if (now_hurt < 5) fc+=now_hurt+" utíkají";
else fc+=now_hurt+" utíká";
fc+=".";
}
say (fc, true, false);
}

void say_thrown()
{
string tc;
if (!allow_helpers) tc="V této hardcore hře jsou pomocníci zakázaní.";
else if (!allow_throwers) tc="V této hardcore hře jsou vyhazovači zakázaní.";
else if (throwers == 0)
{
tc="Žádného vyhazovače jsi ještě neměl";
if (gender==2) tc+="a";
tc+=".";
}
if (tc != "")
{
say (tc, true, false);
return;
}
character@[]@ now=player.count_state (led);
uint8 l=now.length();
if (thrown == 0 and l == 0)
{
tc="Vyhazovači nikoho nevyvedli.";
say (tc, true, false);
return;
}
else if (thrown == 1) tc="Vyhazovači vyvedli jednoho zákazníka.";
else if (thrown>0 and thrown < 5) tc="Vyhazovači vyvedli "+thrown+" zákazníky.";
else if (thrown>0) tc="Vyhazovači vyvedli "+thrown+" zákazníků.";
if (l>0)
{
tc+=" ";
if (l == 1) tc+="Teď vyvádějí jednoho.";
else tc+="Teď vyvádějí "+l+".";
}
say (tc, true, false);
}

uint8 say_misplaced_barrels (bool speak=true)
{
barrel@[] all=barrels;
uint8 l=all.length();
for (uint8 i=0; i<l; i++)
{
barrel@ b=all[i];
if (@b.owner != null or b.y == bottom or (b.x == faucet.x and b.y == faucet.y))
{
all.remove_at (i);
i--;
l--;
}
}
string rep;
if (all.is_empty())
{
rep="Žádné upuštěné sudy.";
if (speak) say (rep, true, false);
return l;
}
else if (l == 1) rep="Jeden upuštěný sud.";
else if (l < 5) rep=l+" upuštěné sudy.";
else rep=l+" upuštěných sudů.";
if (l > 1) rep+=" Nejbližší je ";
else rep+=" Je ";
barrel@ nearest=get_nearest (all, player);
rep+=say_distance (nearest.x, nearest.y).lower();
if (speak) say (rep, true, false);
return l;
}

void say_queue_count()
{
uint8 l=queue.length();
string rep="";
if (l==0) rep="Nikdo ve frontě.";
else rep=l+" ve frontě.";
say (rep, true, false);
}

uint8 say_nonempty (bool speak=true)
{
string rep;
uint8 d=mugs.length(), count=0;
mug@[] result;
result.reserve (d);
for (uint8 i=0; i<d; i++)
{
mug@ m=mugs[i];
if (@m.owner != null or get_distance (m.x, sink.x, m.y, sink.y) == 0 or @m.drank!=null or dirty.find(m)>-1 or m.total==0) continue;
count++;
if (speak) result.insert_last (m);
}
if (speak)
{
if (count == 0) rep="Žádné bezprizorní natočené půllitry.";
else if (count == 1) rep="Jeden bezprizorní natočený půllitr.";
else
{
rep="Celkem ";
if (count < 5) rep+=count+" bezprizorní natočené půllitry.";
else rep+=count+" bezprizorních natočených půllitrů.";
}
if (!result.is_empty())
{
if (result.length() > 1) rep+=" Nejbližší je ";
else rep+=" Je ";
mug@ nearest=get_nearest (result, player);
rep+=say_distance (nearest.x, nearest.y).lower();
rep+=" "+say_mug (false, true, nearest);
}
say (rep, true, false);
}
return count;
}

string say_game (bool speak=true)
{
string game="";
if (is_game)
{
if (is_tutorial) game="Seznámení se hrou ";
else
{
if (endless) game="Nekonečná ";
else if (freeplay) game="Volná ";
else game="Normální ";
if (hardcore) game+="hardcore ";
game+="hra ";
}
game+="na "+diff4[difficulty-1]+" obtížnost. ";
if (endless or freeplay) game+="Hraješ "+get_time (false)+" ";
else game+=get_time();
}
if (hardcore)
{
if (!allow_helpers or (!allow_servers and !allow_givers and !allow_cleaners and !allow_emptiers and !allow_barrelers and !allow_throwers and !allow_calmers)) game+=" Není povolen žádný typ pomocníků.\r\n";
else if (allow_servers and allow_givers and allow_cleaners and allow_emptiers and allow_barrelers and allow_throwers and allow_calmers) game+=" Jsou povoleny všechny typy pomocníků.\r\n";
else
{
game+=" Jsou povolení pomocníci na ";
if (allow_servers) game+="točení, \r\n";
if (allow_givers) game+="roznášení pití, \r\n";
if (allow_cleaners) game+="odnášení špinavých půllitrů, \r\n";
if (allow_emptiers) game+="odnášení prázdných sudů, \r\n";
if (allow_barrelers) game+="nošení nových sudů, \r\n";
if (allow_throwers) game+="vyhazování ožralů, \r\n";
if (allow_calmers) game+="pacifikování agresivních zákazníků, \r\n";
game=append_and (game, true);
}
if (!allow_trips or !allow_falls or !allow_messy or !allow_fallen or !allow_broken or !allow_fled or !allow_mistakes or !allow_stunned or !allow_playerhits)
{
if (game!="") game+="\r\n ";
game+="Hra skončí při ";
if (!allow_trips) game+="zakopnutí, \r\n";
if (!allow_falls) game+="pádu ze schodů, \r\n";
if (!allow_fled) game+="odchodu zákazníka, \r\n";
if (!allow_messy) game+="odchodu všech zákazníků kvůli nepořádku, \r\n";
if (!allow_mistakes) game+="chybě při obsluze, \r\n";
if (!allow_stunned) game+="praštění zákazníka, \r\n";
if (!allow_playerhits) game+="praštění hráče, \r\n";
if (!allow_broken) game+="rozbití půllitru, \r\n";
if (!allow_fallen) game+="rozbití sudu, \r\n";
game=append_and (game, false);
}
}
else if (freeplay and (!free_sleep or !free_trip or !free_puke or !free_roam))
{
game+=" Zákazníci nemůžou ";
if (!free_sleep) game+="usnout, \r\n";
if (!free_trip) game+="zakopávat, \r\n";
if (!free_puke) game+="zvracet, \r\n";
if (!free_roam) game+="začít dělat bordel, \r\n";
game=append_and (game, false);
}
if (speak) say (game, true, false);
return game;
}

string append_and (string source, bool helpers)
{
string[] split=source.split ("\r\n", true);
uint8 l=split.length();
split[l-1]=split[l-1].replace (", ", "", false);
if (l>=2) split[l-2]=split[l-2].replace (", ", " ", false);
if (hardcore)
{
if (helpers and l>1 and (allow_servers or allow_givers or allow_cleaners or allow_emptiers or allow_barrelers or allow_throwers or allow_calmers)) split[l-1]="a "+split[l-1];
if (l>2)
{
if (!helpers) split[l-1]="nebo "+split[l-1];
}
}
else if (l>1 and freeplay) split[l-1]="a "+split[l-1];
source="";
for (uint8 i=0; i<l; i++) source+=split[i];
return source+".";
}

