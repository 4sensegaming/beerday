string motd, uri="https://4sensegaming.cz/beerday/", update_version="";
int motd_day, motd_month, motd_year, motd_hour, motd_minute;
bool postpone_update=false, is_online=false;

string update_bundle_name()
{
if (system_is_windows) return "beerday.zip";
if (PLATFORM.lower().find("darwin") > -1) return "beerday.iso";
return "beerday.tar.gz";
}

bool check_online()
{
http checker;
checker.connect_timeout=5000;
checker.send_timeout=5000;
checker.receive_timeout=5000;
if (!checker.head("https://4sensegaming.cz")) return false;
while (checker.running) wait(5);
int status_code=checker.status_code;
return checker.complete and status_code>=200 and status_code<400;
}

bool external(string path)
{
silence();
bool success=urlopen (path);
if (success)
{
if (pause_on_blur) stop_menu_music();
if (hooked)
{
uninstall_keyhook();
hooked=false;
}
}
else
{
clipboard_set_text(path);
play_stat("error");
say("Nepodařilo se otevřít webový prohlížeč. Adresa stránky byla zkopírována do schránky, takže ji můžeš otevřít ručně.", true, false, true);
}
return success;
}

void read_motd()
{
string raw=file_get_contents(folder+"motd.dat");
if (raw=="") return;
string[] split=raw.split("\t", true);
uint8 l=split.length();
if (l!=6) return;
int[] splitnums;
splitnums.reserve(5);
for (uint8 i=0; i<l-1; i++) splitnums.insert_last(parse_int(split[i]));
if (splitnums.length()!=l-1) return;
motd_day=splitnums[0];
motd_month=splitnums[1];
motd_year=splitnums[2];
motd_hour=splitnums[3];
motd_minute=splitnums[4];
motd=split[5];
}

void write_motd()
{
if (motd=="" or !can_write) return;
string raw=motd_day+"\t"+motd_month+"\t"+motd_year+"\t"+motd_hour+"\t"+motd_minute+"\t"+motd;
file_put_contents(folder+"motd.dat", raw);
}

bool get_motd()
{
string raw=download("motd.dat");
if (raw=="") return false;
string[] split=raw.split("\t", true);
uint8 l=split.length();
if (l!=6) return false;
int[] splitnums;
splitnums.reserve(5);
for (uint8 i=0; i<l-1; i++) splitnums.insert_last(parse_int(split[i]));
if (splitnums.length()!=l-1) return false;
if (split[5]==motd or (motd_day==splitnums[0] and motd_month==splitnums[1] and motd_year==splitnums[2] and motd_hour==splitnums[3] and motd_minute==splitnums[4] and split[5]==motd)) return false;
motd_day=splitnums[0];
motd_month=splitnums[1];
motd_year=splitnums[2];
motd_hour=splitnums[3];
motd_minute=splitnums[4];
motd=split[5];
write_motd();
return true;
}

void say_motd(bool is_new)
{
string rep;
if (is_new) rep="Nová zpráva ";
else rep="Zpráva ";
rep+="dne z "+motd_day+". "+months[motd_month-1]+" ";
if (motd_year!=DATE_YEAR) rep+=motd_year+" ";
rep+="v "+motd_hour+":";
if (motd_minute<10) rep+="0";
rep+=motd_minute+":\r\n"+motd;
if (is_new) wait_sound ("pocket");
is_readmenu=true;
say(rep, true, false, false);
wait_reader(rep, true);
is_readmenu=false;
}

void update(bool silent=true)
{
string lastver=download("lastver.dat");
if (lastver=="")
{
fail_download();
return;
}
string[] split=lastver.split("\t", true);
uint8 l=split.length();
if (l!=6)
{
fail_download();
return;
}
update_version=split[0];
uint update_day=parse_int(split[1]), update_month=parse_int(split[2]), update_year=parse_int(split[3]), update_hour=parse_int(split[4]), update_minute=parse_int(split[5]);
if (update_version==version and update_day==build_day and update_month==build_month and update_year==build_year and update_hour==build_hour and update_minute==build_minute)
{
if (!silent)
{
string rep="Stávající verze "+version+" z "+days[update_day-1]+" "+months[update_month-1];
if (update_year!=DATE_YEAR) rep+=" "+update_year;
rep+=" je pořád aktuální.";
say(rep, true, false);
}
return;
}
string real_minute;
if (update_minute<10) real_minute="0"+update_minute;
else real_minute=""+update_minute;
string um_prompt="Je k dispozici aktualizace na verzi "+update_version+" z "+days[update_day-1]+" "+months[update_month-1];
if (update_year!=DATE_YEAR) um_prompt+=" "+update_year;
um_prompt+=" v "+update_hour+":"+real_minute+".";
string[] um={um_prompt};
int8 tempres=1;
if (!speak_menu_prompt) speak_menu_prompt=true;
um[0]+=" Teď máš verzi "+version+".";
um.insert_last("update_to_version|Stáhnout verzi "+update_version+" do souboru "+update_bundle_name());
um.insert_last("view_changelog|Zobrazit historii změn|"+browser);
um.insert_last("ignore_update|Ignorovat aktualizaci do příštího spuštění");
is_updatemenu=true;
bool is_rerun=false;
while (tempres!=0 and tempres!=3)
{
tempres=make_menu(um, tempres, menu, true, null, is_rerun);
string item=menu.get_item_name(tempres);
um[0]="";
if (speak_menu_prompt!=old_prompt) speak_menu_prompt=old_prompt;
if (instr(item, "ignore"))
{
postpone_update=true;
is_updatemenu=false;
break;
}
else if (instr(item, "update_to_version"))
{
say("Aktualizace se stahuje.", true, false);
download_update();
break;
}
else if (instr(item, "changelog"))
{
read_changelog();
is_rerun=true;
}
}
if (tempres==0) is_updatemenu=false;
silence();
}

void wait_reader(string phrase, bool call_music=false)
{
wait_keys();
ss_start();
string prompt="Pokračuj enterem.";
string helpmsg="Kontrol plus cé: Zkopírování textu do schránky.\r\nEnter, mezerník nebo escape: Potvrzení a pokračování.\r\nKterákoli jiná klávesa: Zopakování textu.\r\nKontrol plus er: Zobrazení textu v seznamu pro pohodlnější čtení.\r\nEf jedna: Zobrazení těchto zkratek v seznamu pro pohodlnější čtení.\r\nAlt plus ef čtyři: Ukončení programu.\r\nDylít nebo kontrol plus šift plus alt: Umlčení řeči.";
reset_ui_help();
if (output>0)
{
if (play_sr_prompt) play_stat("sr");
if (speak_sr_prompt) say(prompt, false, false);
}
help_read=false;
frame.restart();
while (true)
{
if (call_music) menu_music();
closekey();
if (lone(KEY_C) and mod_ctrl() and !mod_shift() and !mod_alt())
{
clipboard_set_text(phrase);
say("Zkopírováno.", true, false);
wait_keys();
}
else if (lone(KEY_R) and mod_ctrl() and !mod_shift() and !mod_alt())
{
string old_read=read_text;
read_menu(phrase, ".?!:;");
wait_keys();
read_text=old_read;
}
else if (singlekey(KEY_F1))
{
read_menu(helpmsg);
help_read=true;
}
else if (singlekey(KEY_RETURN) or singlekey(KEY_NUMPAD_ENTER) or singlekey(KEY_ESCAPE) or singlekey(KEY_SPACE)) break;
else if (down_keys()>0 and !mod_ctrl() and !mod_shift() and !mod_alt() and !key_down(KEY_LGUI) and !key_down(KEY_RGUI))
{
say(phrase, true, false);
wait_keys();
}
if (frame.elapsed>=frame_ms)
{
frame.restart();
if (speak_ui_help)
{
if (ui_help_timer.elapsed<ui_help_delay and down_keys()>0) ui_help_timer.restart();
if (ui_help_timer.elapsed>=ui_help_delay and down_keys()==0 and !help_read)
{
if (is_custmenu) silence_custmenu();
say(helpmsg, false, false);
help_read=true;
ui_help_timer.restart();
ui_help_timer.pause();
}
}
}
wait(5);
}
silence();
wait_keys();
ss_end();
}

void download_update()
{
string bundle_name=update_bundle_name();
string update_file=download(bundle_name);
if (update_file=="")
{
fail_download();
return;
}
if (!file_put_contents(bundle_name, update_file))
{
fail_download();
return;
}
say("Aktualizace se stáhla do souboru "+bundle_name+" ve složce hry. Stačí ji rozbalit a nechat přepsat existující soubory. Potom můžeš soubor "+bundle_name+" smazat. Hra se teď ukončí.", true, false, true);
quit(true);
}

void fail_download()
{
postpone_update=true;
if (is_updatemenu)
{
string failure="Aktualizaci se nepodařilo stáhnout. Zkus si ověřit, že nemáš problémy s připojením k internetu. Pokud to nepomůže, zbývá ještě možnost stáhnout hru pomocí webového prohlížeče, kterou najdeš v nabídce Online funkce.";
play_stat("error");
say(failure, true, false);
wait_reader(failure);
}
is_updatemenu=false;
}

void read_changelog()
{
string log=uri+"changelog.html";
if (!external(log))
{
clipboard_set_text(log);
play_stat("error");
say("Historii změn se nepodařilo otevřít. Můžeš ji zkusit zobrazit v prohlížeči ručně. Adresa stránky byla zkopírována do schránky.", true, false);
}
}

string download(string resource)
{
if (!is_online) return "";
http downloader;
if (!downloader.get(uri+resource))
{
if (enable_debugging) warning("Selhalo zahájení stahování:\r\n"+resource);
return "";
}
sound progress;
if (is_updatemenu)
{
progress.stream ("beep"+ext);
progress.play_looped();
}
downloader.wait();
progress.stop();
if (!downloader.complete)
{
if (enable_debugging) warning("Selhalo stahování:\r\n"+resource);
return "";
}
if (downloader.status_code<200 or downloader.status_code>=400)
{
if (enable_debugging) warning("Server vrátil chybu "+downloader.status_code+":\r\n"+resource);
return "";
}
string data=downloader.response_body;
garbage_collect();
if (data=="")
{
if (enable_debugging) warning("Selhalo stahování, protože soubor je prázdný:\r\n"+resource);
return "";
}
return data;
}