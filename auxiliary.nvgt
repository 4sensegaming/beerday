#include "instance.nvgt"
#include "names.nvgt"
#include "scramble.nvgt"

string folder=SCRIPT_MAIN_PATH+"/userdata/";
instance selftest ("Beertender");
bool onboarding=false, did_learn_sounds=false, did_stereo_test=false;

void initialize()
{
if (selftest.is_already_running)
{
alert ("Chyba!", "Hra už je spuštěná.");
exit();
}
chdir(SCRIPT_MAIN_PATH);
set_application_name (title);
show_window (title+" "+version);
if (!directory_exists (folder)) directory_create (folder);
if (!directory_exists (folder)) can_write=false;
else
{
string name=folder+"test.dat";
file test;
test.open (name, "w");
test.write ("T");
test.close();
if (!file_exists (name)) can_write=false;
else file_delete (name);
}
if (!can_write and question ("Pozor!", "Hra nedokáže zapisovat do svojí datové složky. Hrát sice můžeš, ale nebudou se ti ukládat žádná nastavení ani postup ve hře. Chceš hru spustit i tak?")==2) exit();
pack.open ("*pack.dat");
set_sound_master_volume (loudness);
@sound_default_pack=@pack;
sound_default_decryption_key = scramble();
read_help();
read_tips();
read_tutorial();
read_credits();
used_greetings.reserve (greetings.length());
files=pack.list_files();
uint l=files.length();
for (uint x=0; x<l; x++)
{
if (instr (files[x], "music")) tracks.insert_last (files[x]);
else if (!instr (files[x], ext))
{
files.remove_at (x);
x--;
l--;
}
}
available_tracks=tracks.length();
custbeep.stream ("beep"+ext);
menuloop.stream ("menuloop"+ext);
menustart.stream ("menustart"+ext);
customers.reserve (60);
custpool.reserve (60);
queue.reserve (60);
mugs.reserve (60);
dirty.reserve (60);
barrels.reserve (60);
messes.reserve (full_mug*100);
input.reset(true);
input.set_callback (text_entry_callback);
if (can_write)
{
load_profile();
load_used();
load_soundtrack();
create_stats();
load_stats();
load_player();
load_options();
if (selection==selection_random_keep or selection==selection_manual_keep) load_drinks();
}
read_names();
if (history_entries>0) history.reserve (history_entries);
else history.reserve (1000);
checkup();
if (output==0) changed_output();
if (play_intro)
{
wait_keys();
uint8 counter=0;
sound start, dooropen, doorbell, step, here, doorclose, coin;
start.stream ("start"+ext);
dooropen.stream ("dooropen"+ext);
doorbell.stream ("doorbell"+ext);
here.stream ("collidejukebox"+ext);
doorclose.stream ("doorclose"+ext);
coin.stream (randomize ("coin") +ext);
start.play();
double pan=stereo_left, step_interval=random(40,60)*10, step_time=4000;
dooropen.pan=pan;
doorbell.pan=pan;
doorclose.pan=pan;
bool interrupted_intro=false;
while (start.playing or coin.playing or counter<16)
{
wait (5);
if (key_down (KEY_LALT) and key_pressed (KEY_F4))
{
if (can_write)
{
set_stat ("run_times", 1);
save_stats();
save_profile();
}
exit();
}
if (singlekey (KEY_RETURN) or singlekey (KEY_NUMPAD_ENTER) or singlekey (KEY_ESCAPE) or singlekey (KEY_SPACE))
{
silence();
fadeout (0.5, false, true);
interrupted_intro=true;
break;
}
if (counter==0 and start.position>=800)
{
doorbell.play();
dooropen.play();
counter=1;
}
if (counter==1 and start.position>=1800)
{
say ("4Sense Gaming", true, false);
counter=2;
}
if ((counter<2 or counter>4 and is_window_active()) and output>0) screen_reader_silence();
if (counter==2 and start.position>=3200)
{
say ("Uvádí", true, false);
counter=3;
}
if (counter==3 and start.position>=3400)
{
doorclose.play();
counter=4;
}
for (uint8 i=4; i<14; i++)
if (counter==i and start.position>=step_time)
{
step.close();
step.stream (randomize ("floor")+ext);
step.pan=pan;
if (step.pan<stereo_center)
{
step.play();
step_interval=random(40,60)*10;
step_time+=step_interval;
pan+=(stereo_right/10);
}
counter++;
if (counter==14)
{
step.play();
here.play();
counter=15;
}
}
if (counter==15 and !doorbell.playing and !step.playing and !here.playing)
{
coin.play();
counter=16;
}
if (!is_window_active())
{
if (dooropen.playing) dooropen.pause();
if (doorbell.playing) doorbell.pause();
if (doorclose.playing) doorclose.pause();
if (step.playing) step.pause();
if (start.playing) start.pause();
if (coin.playing) coin.pause();
while (!is_window_active()) wait(5);
if (doorbell.paused) doorbell.play();
if (dooropen.paused) dooropen.play();
if (doorclose.paused) doorclose.play();
if (step.paused) step.play();
if (start.paused) start.play();
if (coin.paused) coin.play();
}
}
if (!interrupted_intro)
{
if (play_menu_music and file_exists (folder+"profile.dat"))
{
menustart.play();
played_menu_start=true;
}
say (title, true, false);
wait_delay();
}
}
if (!file_exists (folder+"profile.dat"))
{
onboarding=true;
say_first ("Tato hra nikdy žádným způsobem neodesílá žádná data mně, vlastnímu serveru ani jakékoli třetí straně. Veškerá uložená nastavení zůstávají pouze na tvém vlastním disku, dají se kdykoli smazat, neobsahují žádné osobní údaje a jsou uložena v nečitelné, zašifrované podobě.");
say_sleep_mode();
say_first ("F1 kdykoli zobrazí klávesové zkratky, kterými se ovládá nabídka nebo obrazovka, kde právě jsi. Tato nápověda se přečte i automaticky, pokud pět vteřin nestiskneš žádnou klávesu.");
say_first ("Než se budeš moct pustit do hraní, věnuj prosím chvilku nastavení několika údajů, díky kterým se ti hra přizpůsobí na míru. Každá změna nastavení se hned uloží, takže nemusíš nic potvrzovat a můžeš rovnou každou nabídku zavřít escapem.");
profile_options();
profile.set ("name_day", name_day);
profile.set ("name_month", name_month);
profile.set ("birth_day", birth_day);
profile.set ("birth_month", birth_month);
created_day=DATE_DAY;
created_month=DATE_MONTH;
created_year=DATE_YEAR;
created_hour=TIME_HOUR;
created_minute=TIME_MINUTE;
profile.set ("created_day", created_day);
profile.set ("created_month", created_month);
profile.set ("created_year", created_year);
profile.set ("created_hour", created_hour);
profile.set ("created_minute", created_minute);
say_first ("Díky. Teď si ještě můžeš nastavit ostatní vlastnosti a chování hry. Pokud ti nebude jasné, co některé nastavení dělá, můžeš si hru nejdřív trochu osahat a k nastavením se vrátit kdykoli později.");
options();
if (!did_stereo_test)
{
say_first ("Teď si ještě ověříme, že máš správně nasazená sluchátka nebo umístěné reproduktory, aby se správně přehrávaly zvuky ve stereu.");
speakers();
}
if (!did_learn_sounds)
{
int8 l=ask ("Chceš se rovnou seznámit s nejdůležitějšími zvuky, které budeš při hraní potřebovat?");
if (l==1) learn();
else say_first ("Položka Seznámení se zvuky je kdykoli dostupná v hlavním menu, v nabídce nastavení zvuku, anebo přímo během hry jednak v kontextovém menu a jednak po stisknutí klávesy F3.");
}
onboarding=false;
did_learn_sounds=false;
did_stereo_test=false;
say_first ("Tak, to už je opravdu všechno. Nic víc nepotřebuješ. Nebudu tě ani trápit s žádnými nudnými návody, protože hra tě na začátku postupně všechno sama naučí a ukáže ti, jak se hraje. Pusť se do toho. Hodně štěstí!");
save_player();
save_options();
save_profile();
}
set_stat ("run_times", 1);
if (play_menu_music)
{
menustart.play();
played_menu_start=true;
if (!play_intro) wait_delay();
}
}

void say_first (string text)
{
if (menuloop.playing) menuloop.stop();
say (text, true, false);
wait_reader (text, false);
}

void say_sleep_mode()
{
if (output==4) say ("Pro optimální chod hry je nejlepší NVDA po každém spuštění uspat. Nebude se tak nechtěně přerušovat řeč tím, že stiskneš některou klávesu. Příslušná klávesová zkratka je NVDA plus šift plus es v desktopovém rozložení klávesnice a NVDA plus šift plus zet v laptopovém.", false, false, true);
}

void quit (bool silent=false, bool is_updating=false)
{
if (!silent)
{
silence (play_outro);
pause(false);
if (play_outro) leave (false);
if (menuloop.playing or menustart.playing) fadeout (0.5, false);
}
if (autoplay or freeplay or is_tutorial) clear_earnings();
if (is_game) make_stats (true);
if (can_write and !is_updating and !onboarding)
{
save_used();
save_player();
save_stats();
save_options();
if (!beers.is_empty() and (selection==selection_random_keep or selection==selection_manual_keep)) save_drinks();
save_names();
save_profile();
if ((save_history or copy_history) and !history.is_empty())
{
string history_all="";
uint l=history.length();
for (int i=l-1; i>-1; i--) history_all+=history[i]+"\r\n";
if (copy_history) clipboard_set_text (history_all);
if (save_history) file_put_contents ("speech_history.txt", history_all);
}
}
file_delete (folder+"temp.ogg");
file_delete (folder+"controls.html");
exit();
}

void error (string msg="", bool wait=false, bool interrupt=true)
{
if (autoplay) return;
play_stat ("error");
if ((speak_errors or is_tutorial or onboarding) and msg != "") say (msg, interrupt, false, wait);
}

int8 ask (string q, bool cancel=false, bool stop=true)
{
string old_question=menu_question;
menu_question=q;
if (stop) silence (true);
else if (is_custmenu and menu.running) silence_custmenu();
if (speak_menu_prompt!=old_prompt) speak_menu_prompt=old_prompt;
dynamic_menu askmenu;
dynamic_menu@ last_menu=@top_menu;
askmenu.wrap=false;
askmenu.allow_escape=cancel;
askmenu.enable_home_and_end=true;
askmenu.set_callback (callback, "");
askmenu.add_item_tts ("yes", "ano");
askmenu.add_item_tts ("no", "ne");
if (cancel) askmenu.add_item_tts ("cancel", "zrušit");
get_characters();
reset_ui_help();
if (is_game and !menu.running and !keyhelp)
{
oldpaused=paused;
pause();
}
int8 a=askmenu.run (q, 1, true);
if (cancel and a == 0) a=3;
if (a == 3)
{
if (is_game and paused and !menuloop.playing and !menustart.playing and !play_menu_sounds) say ("Zrušeno.", true, false);
else silence();
}
menu_question=old_question;
wait_keys();
if (is_game and !menu.running and !keyhelp)
{
if ((!instr (q, "hru") or a==2) and !play_outro) stop_menu_music();
if ((!instr (q, "končit") or a==2) and !oldpaused)
{
resume();
oldpaused=false;
}
}
if (@last_menu!=null and last_menu.running and !last_menu.speak_item) last_menu.speak_item=true;
return a;
}

bool instr (string source, string part)
{
if (source == "" or part == "") return false;
return source.find (part) > -1;
}

string utf8_first_char(const string &in text)
{
if (text == "") return "";
int next=utf8next(text, 0);
if (next <= 0) return "";
return text.substr(0, next);
}

string utf8_first_char_lower(const string &in text)
{
string ch=utf8_first_char(text);
if (ch == "") return "";
return ch.lower();
}

bool is_s_or_z_sound(const string &in text)
{
string ch=utf8_first_char_lower(text);
return ch == "s" or ch == "š" or ch == "z" or ch == "ž";
}

string convert_symbol (string what)
{
int8 f=symbols.find (what);
if (f > -1) return descriptions[f];
return what;
}

void copy (string what)
{
if (what=="") return;
clipboard_set_text (what);
if (!is_readmenu) say (history[history_index]+" zkopírováno do schránky.", true, false);
else say ("Seznam zkopírován do schránky.", true, false);
}

void spell (string entry)
{
entry=entry.replace ("\r\n", "\n", true);
bool first=true;
int i=0, len=int(entry.length());
while (i < len)
{
int next=utf8next(entry, i);
if (next <= i) break;
string char=entry.substr(i, next-i);
char=convert_symbol (char);
if (char != char.lower()) char="velké "+char.lower();
say (char, first, false, false);
if (first) first=false;
i=next;
}
}

void read_tips()
{
datastream@ f=pack.get_file ("tips.dat");
string raw=string_aes_decrypt (f.read(), scramble());
string[] split;
split.reserve (100);
tips.reserve (100);
split=raw.split ("\r\n", true);
uint l=split.length();
for (uint i=0; i<l; i++) tips.insert_last (split[i]);
used_tips.reserve (tips.length());
}

void save_profile()
{
if (!can_write) return;
file f;
if (!f.open (folder+"profile.dat", "wb")) return;
f.write (string_aes_encrypt (profile.serialize(), scramble()));
}

void load_profile()
{
profile.delete_all();
file f;
if (!f.open (folder+"profile.dat", "rb")) return;
string raw=string_aes_decrypt (f.read(), scramble());
if (raw=="") return;
profile=deserialize (raw);
}

void read_credits()
{
datastream@ creds=pack.get_file ("credits.dat");
credits=string_aes_decrypt (creds.read(), scramble());
}

void wait_delay (double delay=2000)
{
timer waiter;
while (waiter.elapsed<delay)
{
if (!keys_down().is_empty()) break;
wait(5);
}
silence (true);
}