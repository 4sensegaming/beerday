#if windows
#pragma stub nc
#endif
#if linux
#pragma stub nc
#endif
#pragma embed "pack.dat"

#include "constants.nvgt"
#include "net.nvgt"
#include "audio.nvgt"
#include "help.nvgt"
#include "keyboard.nvgt"
#include "auxiliary.nvgt"
#include "game.nvgt"
#include "options.nvgt"
#include "stats.nvgt"
#include "menus.nvgt"

bool can_write=true;
pack_file pack;
timer frame, runtime;

void main()
{
initialize();
read_motd();
is_online=check_online();
if (is_online)
{
if (get_motd()) say_motd (true);
if (updates) update();
}
menus();
double frame_step=frame_ms, frame_bank=0;
frame.restart();
while (true)
{
keyboard();
wait (5);
double delta=frame.elapsed;
if (delta <= 0) continue;
frame.restart();
frame_bank+=delta;
while (frame_bank >= frame_step)
{
if (!paused) game();
frame_bank-=frame_step;
}
}
}
