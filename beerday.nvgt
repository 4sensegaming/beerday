#pragma embed "pack.dat"

#include "constants.nvgt"
#include "net.nvgt"
#include "audio.nvgt"
#include "help.nvgt"
#include "keyboard.nvgt"
#include "auxiliary.nvgt"
#include "game.nvgt"
#include "options.nvgt"
#include "stats.nvgt"
#include "menus.nvgt"

bool can_write=true;
pack_file pack;
timer frame, runtime;

void main()
{
is_online=check_online();
initialize();
read_motd();
if (is_online)
{
if (get_motd()) say_motd (true);
if (updates) update();
}
cleanup();
if (file_exists (folder+"profile.dat") and enable_debugging and (lastrun_day!=DATE_DAY or lastrun_month!=DATE_MONTH or lastrun_year!=DATE_YEAR)) say_first ("Happy Beerday je zatím v předběžném přístupu. Je možné, že ještě budeš narážet na  chyby. Jakoukoli případnou chybu mi můžeš nahlásit příslušnou položkou v nabídce Online funkce. Předem díky moc.");
lastrun_day=DATE_DAY;
lastrun_month=DATE_MONTH;
lastrun_year=DATE_YEAR;
lastrun_hour=TIME_HOUR;
lastrun_minute=TIME_MINUTE;
menus();
frame.restart();
while (true)
{
wait (5);
keyboard();
if (frame.elapsed >= 1000/fps)
{
frame.restart();
if (!paused) game();
}
}
}