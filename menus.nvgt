#include "dynamic_menu.nvgt"
#include "text.nvgt"

dynamic_menu@ top_menu=null;
dynamic_menu menu;
text input;
string menu_question, read_text="";
int result=1, conresult=1, gameres=1;
uint8 custcounter=0;
bool oldpaused=false, custchanged=false, is_learnmenu=false, is_custmenu=false, is_conmenu=false, is_optionsmenu=false, is_readmenu=false, is_statmenu=false, is_gallery=false, is_updatemenu=false, is_namemenu=false, help_read=false;
timer ui_help_timer;

bool parse_menu_flag(string value)
{
string lowered=value.lower();
return lowered=="1" or lowered=="true";
}

uint8 parse_menu_checked(string value)
{
if (value=="2") return 2;
if (parse_menu_flag(value)) return 1;
return 0;
}

int callback (dynamic_menu@ handle, string user_data)
{
if (@top_menu!=@handle) @top_menu=@handle;
closekey();
if (is_readmenu and won.active and !won.playing and !won.paused) return -1;
if (!is_gallery) menu_music();
else if (is_game and menu_question=="")
{
game();
if (player.state==opening or player.state==closing or player.state==fleeing or player.state==tripped or player.state==falldown) return -1;
}
int oldpos=handle.get_position(), pos=oldpos;
if (singlekey (KEY_F1) and !instr (read_text, "ásledující") and !instr (read_text, "Potvrzení a pokračování") and !instr (read_text, "stereo") and !instr (read_text, "zadávej"))
{
ui_help (false);
silence();
if (menu_question!="") say (menu_question, true, false);
handle.speak_item=true;
return 0;
}
else if (singlekey (KEY_SPACE))
{
silence();
if (menu_question!="") say (menu_question, true, false, false);
else
{
handle.part=pos;
handle.old_part=0;
}
handle.speak_item=true;
}
if (menu_question != "")
{
if (singlekey (KEY_A))
{
wait_answered (menu_question!="Ukončit program?");
return 1;
}
else if (singlekey (KEY_N))
{
wait_answered();
return 2;
}
else if ((singlekey (KEY_Z) or singlekey (KEY_Y)) and handle.get_item_count() == 3)
{
wait_answered();
return 3;
}
}
if (is_custmenu and !is_readmenu and custbeep.playing) custcounter++;
uint count=handle.get_item_count();
if (count > 10)
{
if (singlekey (KEY_PAGEUP))
{
if (pos -10 > 0) pos-=10;
else play_stat ("edge");
}
else if (singlekey (KEY_PAGEDOWN))
{
if (pos+10 <= count) pos+=10;
else play_stat ("edge");
}
if (pos != oldpos)
{
if (is_custmenu and !is_readmenu and @handle!=@menu and menu_question=="")
{
custchanged=true;
custcounter=0;
}
play_move();
handle.menu_position=pos;
handle.part=handle.item_list[handle.menu_position-1].section;
handle.speak_item=true;
}
}
if (is_custmenu and !is_readmenu and @handle!=@menu and menu_question=="")
{
if (custchanged)
{
custchanged=false;
custcounter=0;
character@h =get_customer (handle.get_item_name (pos));
character_position (h, true);
string doing;
switch (h.state)
{
case opening: doing="dooropen"; break;
case closing: doing="doorclose"; break;
case ordering: doing="pipe"; break;
case waiting: doing="smoke"; break;
case drinking: doing="burp1"; break;
case idle: doing="snore"; break;
case disposing: doing="wash2"; break;
case mugging: doing="pickmug"; break;
case piping: doing="pour"; break;
case cleaning: doing="mugloop"; break;
case tripped: doing="trip1"; break;
case falldown: doing="fell3"; break;
}
if (h.is_chasing or h.is_roaming or (h.leaving==1 and h.health>=h.attack)) doing="alert";
else if (h.state == serving or h.state == giving) doing="drop1";
else if (h.state == arriving or h.state == returning)
{
if (h.x == stairs) doing="stairs1";
else if (h.y == 0) doing="floor1";
else doing="creak1";
}
else if (h.state == barreling or h.state == emptiing) doing="barrel";
else if (h.state == throwing or h.state == calming) doing="hit1";
else if (h.health <= h.attack) doing="beat";
doingsound.load (doing+ext);
position_sound_2d (doingsound, player.x, player.y, h.x, h.y, pool.pan_step, pool.volume_step, pool.behind_pitch_decrease);
doingsound.pitch=100 -abs(h.y/2);
doingsound.volume=menu_sounds_vol;
doingsound.play();
if (h.x == player.x and h.y == player.y)
{
customer_here.stop();
customer_here.play();
}
}
if (custbeep.playing)
if ((output == 0 and !fallback_voice.speaking) or (output>0 and custcounter>fps))
{
custcounter=0;
silence_custmenu();
}
if (!is_readmenu and lone (KEY_R) and mod_ctrl() and !mod_shift() and !mod_alt()) read_menu (handle.item_list[pos-1].ui_name, ".");
}
if (is_readmenu and lone (KEY_C) and mod_ctrl() and !mod_shift() and !mod_alt())
{
get_characters();
copy (read_text);
}
if (menu_question=="") nav (handle);
if (speak_ui_help and foreground)
{
if (ui_help_timer.elapsed>=ui_help_delay and down_keys()==0 and !fallback_voice.speaking) ui_help (true);
if (down_keys()>0 and ui_help_timer.elapsed<ui_help_delay) ui_help_timer.restart();
}
return 0;
}

uint make_menu (string[]@ which, int start=1, dynamic_menu@ handle=@menu, bool autospeak=true, string[]@ sections=null, bool rerun=false)
{
handle.running=false;
handle.reset (false);
handle.allow_escape=true;
if (is_custmenu or is_readmenu) handle.wrap=false;
else handle.wrap=menu_wrap;
handle.set_callback (callback, "");
handle.enable_home_and_end=true;
uint l=which.length();
for (uint x=1; x<l; x++)
{
string[] split=which[x].split("|", true);
uint8 l=split.length();
string name=split[0], ui_name=split[0], description="", section="1", checkbox="2";
bool submenu=false, disabled=false;
if (l>1) ui_name=split[1];
if (l>2 and split[2]!=" " and split[2]!="") description=split[2];
if (l>3 and split[3]!=" " and split[3]!="" and split[3]!="0" and split[3]!="1") section=split[3];
if (l>4 and split[4]!=" " and split[4]!="" and split[4]!="2") checkbox=split[4];
if (l>5 and parse_menu_flag(split[5])) submenu=true;
if ((l>6 and parse_menu_flag(split[6])) or (is_readmenu and !is_online))
{
disabled=true;
if (is_gallery and !is_game and description=="" and disabled) description="Ještě nezaznělo ve hře";
}
handle.add_item_tts (name, ui_name, description, int(parse_int(section)), parse_menu_checked(checkbox), submenu, disabled);
}
if (@sections!=null) @handle.sections=@sections;
ui_help_timer.restart();
if (autospeak and !rerun) help_read=false;
get_characters();
return handle.run (which[0], start, autospeak, rerun);
}

void menus()
{
result=1;
bool is_rerun=false;
while (true)
{
string[] mm=main_menu;
uint8 l=mm.length();
for (uint8 i=0; i<l; i++)
{
if (instr (mm[i], "stereo")) mm[i]+=mono_audio;
else if (instr (mm[i], "music")) mm[i]=mm[i].substr (0, mm[i].length()-1)+play_menu_music;
	else if (instr (mm[i], "motd")) mm[i]+=motd=="";
else if (instr (mm[i], "online"))
{
if (!is_online) mm[i]+=" Vyžaduje připojení k internetu.";
mm[i]+="|3|2|1|";
mm[i]+=!is_online;
}
else if (instr (mm[i], "profile")) mm[i]+=!file_exists(folder+"profile.dat");
}
string[] secs={"", "Zvuk", "Ostatní"};
result=make_menu (mm, result, @menu, true, secs, is_rerun);
if (result == -1) continue;
is_rerun=false;
string item=menu.get_item_name (result);
if (item == "play")
{
if (game_menu())
{
reset();
break;
}
}
else if (instr (item, "options")) options();
else if (instr (item, "learn")) learn();
else if (instr (item, "stereo_test")) speakers();
else if (instr (item, "stats")) view_stats();
else if (instr (item, "music"))
{
switch_menu_music();
is_rerun=true;
}
else if (instr (item, "motd")) say_motd (false);
else if (instr (item, "credits")) read_menu (credits);
else if (instr (item, "tips")) read_menu (tips);
else if (instr (item, "online")) online_menu();
else if (instr (item, "profile")) clear_profile();
else quit();
}
}

void online_menu()
{
int8 tempres=1;
bool is_rerun=false;
while (tempres>0)
{
string[] om={"Nabídka online funkcí", "gallery|Hudební síň slávy|Poslechni si všechny legendární a stoprocentně vážně míněné AI songy použité ve hře v naprostém klidu a v původní kvalitě!|1|2|1", "web|Stránka hry|"+browser+"|2", "discord|Discord server 4Sense Gaming|"+browser+"|2", "changelog|Historie změn v jednotlivých verzích|"+browser+"|2", "roadmap|Roadmapa (orientační plán dalšího vývoje)|"+browser+"|2", "contact|Kontaktovat autora|Otevře ve výchozím webovém prohlížeči stránku, kde mi můžeš nahlásit chybu nebo sdělit jakoukoli jinou zpětnou vazbu.|2"};
if (!postpone_update and update_version!="") om.insert_last ("install_update|Aktualizovat na verzi "+update_version+"| |3");
else if (!updates and !postpone_update and update_version=="") om.insert_last ("check_update|Vyhledat aktualizace| |3");
om.insert_last ("redownload|Znovu stáhnout ZIP archiv nejnovější verze|Stáhne se pomocí výchozího webového prohlížeče do stejné složky, kam se standardně ukládají i jiné stažené soubory. Program se ukončí.|3");
string[] secs={"", "Komunita", "Aktualizace"};
tempres=make_menu (om, tempres, menu, true, secs, is_rerun);
is_rerun=true;
string item=menu.get_item_name (tempres);
silence();
if (instr (item, "gallery"))
{
gallery();
is_rerun=false;
}
else if (instr (item, "web")) external (uri);
else if (instr (item, "discord")) external ("https://discord.gg/uTq6WRhrJJ");
else if (instr (item, "changelog")) external (uri+"changelog.html");
else if (instr (item, "roadmap")) external (uri+"roadmap.html");
else if (instr (item, "contact")) external (uri+"kontakt");
else if (instr (item, "install"))
{
download_update();
break;
}
else if (instr (item, "check"))
{
update(false);
if (postpone_update)
{
tempres=1;
is_rerun=false;
}
}
else if (instr (item, "redownload"))
{
if (external (uri+update_bundle_name())) quit(true);
}
}
if (update_version!="") update_version="";
}

void read_menu (string text, string separators="\r\n")
{
read_text=text;
string[] split=text.split(separators, false);
split.insert_at (0, "Seznam pro pohodlnější čtení");
if (!is_readmenu and !instr (read_text, "ásledující") and !instr (read_text, "stereo") and !instr (read_text, "Potvrzení a pokračování") and !instr (read_text, "zadávej") and !is_tutorial) speak_menu_prompt=true;
else if (speak_menu_prompt!=old_prompt) speak_menu_prompt=old_prompt;
if (is_custmenu) silence_custmenu();
ss_start();
bool old_read=is_readmenu;
is_readmenu=true;
dynamic_menu readmenu;
int tempres=1;
bool is_rerun=false;
while(tempres>0)
{
tempres=make_menu (split, tempres, readmenu, true, null, is_rerun);
if (tempres==0 or tempres==-1) break;
string link=readmenu.get_item_name (tempres);
if (link!="" and !external (link)) break;
else is_rerun=true;
}
is_readmenu=old_read;
speak_menu_prompt=old_prompt;
read_text="";
ss_end();
}

void set_difficulty()
{
string[] diffm;
uint8 l=diff.length();
for (uint8 i=0; i<l; i++)
diffm.insert_last (diff[i]+"|"+diff[i]+"|"+diff_desc[i]);
uint8 actual_diff=difficulty;
actual_diff=make_menu (diffm, actual_diff);
if (actual_diff>0) difficulty=actual_diff;
}

void speakers()
{
if (onboarding) did_stereo_test=true;
wait_keys();
bool success=say ("Levá strana.", true, false, output==0);
if (!success or !wait_speakers()) return;
if (!stereo_invert) success=play_speakers (stereo_left);
else success=play_speakers (stereo_right);
if (!success or !wait_speakers()) return;
success=say ("Střed.", true, false, output==0);
if (!success or !wait_speakers()) return;
success=play_speakers (stereo_center);
if (!success or !wait_speakers()) return;
success=say ("Pravá strana.", true, false, output==0);
if (!success or !wait_speakers()) return;
if (!stereo_invert) success=play_speakers (stereo_right);
else success=play_speakers (stereo_left);
if (!success or !wait_speakers()) return;
if (!is_optionsmenu and ask ("Prohodit levý a pravý kanál?", false, false)==1) stereo_invert=!stereo_invert;
}

bool wait_speakers()
{
frame.restart();
while (frame.elapsed < 1000)
{
menu_music();
closekey();
if (!onboarding and down_keys() > 0)
{
frame.restart();
frame.pause();
return false;
}
wait (5);
}
frame.restart();
frame.pause();
return true;
}

bool play_speakers (double panning)
{
return wait_sound ("edge", false, true, panning);
}

void options()
{
ss_start();
is_optionsmenu=true;
int8 tempres=1;
while (tempres!=0)
{
string[] optmenu=options_menu;
if (onboarding) optmenu.remove_last();
tempres=make_menu (optmenu, tempres);
string item=menu.get_item_name (tempres);
if (instr (item, "ui")) ui_options();
else if (instr (item, "audio")) audio_options();
else if (instr (item, "game")) game_options();
else if (instr (item, "control")) control_options();
else if (instr (item, "profile")) profile_options();
else if (instr (item, "restore"))
{
restore_all_defaults();
break;
}
else if (instr (item, "done")) break;
menu.speak_item=true;
}
is_optionsmenu=false;
ss_end();
}

void learn()
{
silence();
ss_start();
is_learnmenu=true;
if (onboarding) did_learn_sounds=true;
int tempres=-1;
string[] secs={"Pípa a točení", "Půllitry", "Sudy", "Pohyb", "Nárazy", "Zákazníci", "Dveře", "Nakupování", "Uživatelské rozhraní", "Nabídky"};
string[] lm=learnmenu;
while (true)
{
if (tempres == -1)
{
tempres=1;
tempres=make_menu (lm, 1, menu, true, secs);
}
else if (tempres == 0) break;
else
{
silence (true);
string to_play=learn_sounds[tempres-1];
int playing_sound=play_stat (to_play, looping_sounds.find(to_play)>-1, true);
if (pause_music.find(to_play)>-1 and (menuloop.playing or menustart.playing))
{
wait_keys();
if (menuloop.playing) menuloop.pause();
else if (menustart.playing) menustart.pause();
while (playing_sound>-1 and pool.sound_is_playing (playing_sound))
{
if (!keys_down().is_empty()) pool.destroy_sound (playing_sound);
wait(5);
}
}
tempres=menu.run ("", tempres, false, true);
}
}
is_learnmenu=false;
ss_end();
}

void con()
{
ss_start();
is_conmenu=true;
bool is_rerun=false;
string[] sections={"Informace", "Zákazníci", "Fronta", "Sledování zákazníků", "Půllitry", "Sudy", "Historie řeči", "Hráč", "Ostatní"};
conresult=1;
while (true)
{
string[] conmenu={"Kontextové menu"};
conmenu.insert_last ("square_info|Popis políčka, kde právě stojíš (mezerník)| |1");
conmenu.insert_last ("door_info|Kde jsou dveře (dé)| |1");
conmenu.insert_last ("faucet_info|Kde je pípa (ef)| |1");
conmenu.insert_last ("sink_info|Kde je dřez (I)| |1");
conmenu.insert_last ("stairs_info|Kde jsou schody (es)| |1");
conmenu.insert_last ("jukebox_info|Kde je jukebox (jé)| |1");
conmenu.insert_last ("say_game_info|Informace o hře (té)| |1");
if (fled > 0) conmenu.insert_last ("customers_left_info|Kolik zákazníků odešlo (el)| |2");
if (thrown > 0) conmenu.insert_last ("customers_bounced|Kolik ožralů pomocníci vyhodili (šift plus el)| |2");
if (served > 0) conmenu.insert_last ("served_drinks_info|Kolik zákazníků dostalo pití (gé)| |2");
if (!queue.is_empty())
{
conmenu.insert_last ("queue_info|Kolik zákazníků je ve frontě (qé)| |3");
conmenu.insert_last ("queue_count_info|Kolik zákazníků je ve frontě, bez popisu prvního zákazníka (šift plus qé)| |3");
}
if (customers.length() > 0)
{
if (@tracking==null) conmenu.insert_last ("all_customers_info|Souhrn všech zákazníků (cé)| |4");
else
{
tracking.set_prepend();
conmenu.insert_last ("tracked_customer_info|Kde je "+tracking.prepend+" (cé)| |4");
}
if (@tracking==null) conmenu.insert_last ("all_customers_menu|Přehled všech zákazníků (šift plus cé)| |4");
else
{
player.set_append(tracking);
conmenu.insert_last ("customer_stop_tracking|Přestat sledovat "+player.append+" (šift plus cé)| |4");
}
character@ h=name_local_customer (true);
if (@h!=null)
{
string r="customer_name_local|";
if (h.name=="")
{
player.set_append(h);
r+="Pojmenovat "+player.append;
}
else r+="Přejmenovat "+h.name4;
conmenu.insert_last (r+" (kontrol plus cé)| |4");
}
}
if (!player.carrying.is_empty())
{
conmenu.insert_last ("mugs_count_info|Kolik neseš půllitrů (em)| |5");
conmenu.insert_last ("mugs_description_info|Souhrn půllitrů, které neseš (kontrol plus em)| |5");
if (@player.hand != null) conmenu.insert_last ("mug_holding_info|Jaký držíš půllitr (šift plus em)| |5");
}
if (say_dirty (false) > 0) conmenu.insert_last ("discarded_mugs_info|Kolik je odložených půllitrů (U)| |5");
if (say_nonempty (false) > 0) conmenu.insert_last ("discarded_nonempty_mugs_info|Kolik je bezprizorních natočených půllitrů (kontrol plus U)| |5");
if (broken > 0) conmenu.insert_last ("broken_mugs_info|Kolik se rozbilo půllitrů (šift plus U)| |5");
if (@player.has_barrel != null) conmenu.insert_last ("barrel_info|Jaký neseš sud (bé)| |6");
if (fallen > 0) conmenu.insert_last ("broken_barrels_info|Kolik se rozbilo sudů (šift plus bé)| |6");
if (replaced > 0) conmenu.insert_last ("replaced_barrels_info|Kolik se vyměnilo sudů (kontrol plus bé)| |6");
if (say_misplaced_barrels (false) > 0) conmenu.insert_last ("misplaced_barrels_info|Kolik je upuštěných sudů (alt plus bé)| |6");
if (!history.is_empty())
{
conmenu.insert_last ("history_repeat_last|Zopakovat aktuální hlášku v historii (dvojité vé)| |7");
conmenu.insert_last ("history_copy_current|Zkopírovat aktuální hlášku do schránky (kontrol plus dvojité vé)| |7");
conmenu.insert_last ("history_spell_current|Vyhláskovat aktuální hlášku (šift plus dvojité vé)| |7");
}
conmenu.insert_last ("player_position_info|Kde jsi v prostoru (tab)| |8");
string injured="health_info|Jak moc jsi zraněn";
if (gender==2) injured+="á";
else injured+="ý";
conmenu.insert_last (injured+" (há)| |8");
if (money > 0) conmenu.insert_last ("money_info|Kolik máš vyděláno (E)| |8");
conmenu.insert_last ("keyhelp_menu|Klávesová nápověda (ef jedna)| |9");
conmenu.insert_last ("options_menu|Nastavení (ef dva)| |9");
conmenu.insert_last ("learn_sounds_menu|Seznámení se zvuky (ef tři)| |9");
conresult=make_menu (conmenu, conresult, menu, true, sections, is_rerun);
is_rerun=true;
if (conresult == 0)
{
if (paused and !menuloop.playing and !play_menu_sounds) say ("Zrušeno.", true, false);
break;
}
string item=menu.get_item_name (conresult);
if (instr (item, "game_info")) say_game();
else if (instr (item, "square")) info();
else if (instr (item, "queue_info")) say_queue();
else if (instr (item, "queue_count")) say_queue_count();
else if (instr (item, "door")) say (say_door (false), true, false);
else if (instr (item, "sink")) say (say_sink (false), true, false);
else if (instr (item, "jukebox")) say (say_jukebox (false), true, false);
else if (instr (item, "faucet")) say (say_pipe (false), true, false);
else if (instr (item, "stairs")) say ("Schody jsou "+say_distance (stairs, 0, false), true, false);
else if (instr (item, "health")) say (player.say_health(), true, false);
else if (instr (item, "money")) say_earned();
else if (instr (item, "discarded_mugs")) say_dirty();
else if (instr (item, "nonempty")) say_nonempty();
else if (instr (item, "served")) say_given();
else if (instr (item, "mugs_count")) say_mugs();
else if (instr (item, "mugs_description")) say (count_mugs (player), true, false);
else if (instr (item, "mug_holding")) say_mug (true, true, player.hand);
else if (instr (item, "barrel_info")) say_barrel();
else if (instr (item, "customers_info")) say_customers();
else if (instr (item, "tracked")) say_customer (tracking, true);
else if (instr (item, "customers_menu"))
{
track_menu();
is_rerun=false;
}
else if (instr (item, "tracking")) untrack();
else if (instr (item, "local"))
{
name_local_customer();
is_rerun=false;
}
else if (instr (item, "left")) say_fled();
else if (instr (item, "bounced")) say_thrown();
else if (instr (item, "broken_mugs")) say_broken_mugs();
else if (instr (item, "broken_barrels")) say_broken_barrels();
else if (instr (item, "replaced")) say_replaced_barrels();
else if (instr (item, "misplaced")) say_misplaced_barrels();
else if (instr (item, "position")) character_position (player, false);
else if (instr (item, "history_repeat")) say (history[history_index], true, false);
else if (instr (item, "copy")) copy (history[history_index]);
else if (instr (item, "spell")) spell (history[history_index]);
else if (instr (item, "keyhelp"))
{
help();
is_rerun=false;
}
else if (instr (item, "options"))
{
options();
is_rerun=false;
}
else if (instr (item, "learn"))
{
learn();
is_rerun=false;
}
}
is_conmenu=false;
ss_end();
}

void nav (dynamic_menu@ handle)
{
if (mod_ctrl() or mod_shift() or mod_alt()) return;
string raw=get_characters();
if (raw == "") return;
int next=utf8next(raw, 0);
if (next <= 0 or next != int(raw.length())) return;
string char=raw.substr(0, next).lower();
if (char == " " or !char.is_alphabetic()) return;
uint current=handle.get_position(), m=handle.item_list.length();
int found=-1;
for (uint i=current; i<m; i++)
{
string first=utf8_first_char_lower(handle.item_list[i].ui_name);
if (first!="" and char==first)
{
found=i;
break;
}
}
if (found == -1)
for (uint i=0; i<current-1; i++)
{
string first=utf8_first_char_lower(handle.item_list[i].ui_name);
if (first!="" and char==first)
{
found=i;
break;
}
}
if (found == -1)
{
if (play_menu_sounds) play_stat ("error");
found=current;
}
else
{
play_move();
handle.menu_position=found+1;
handle.part=handle.item_list[handle.menu_position-1].section;
}
if (is_custmenu and @handle==@menu and menu_question=="") custchanged=true;
if (found>-1)
{
handle.speak_item=true;
silence();
}
}

void ss_start()
{
if (!is_game or speaking_tutorial or menu.running or @top_menu!=null or keyhelp or is_optionsmenu or is_learnmenu or is_conmenu or is_custmenu or is_readmenu or is_gallery or menu_question!="") return;
oldpaused=paused;
pause (false);
//wait_keys();
}

void ss_end()
{
if (!is_game or speaking_tutorial or menu.running or @top_menu!=null or keyhelp or is_conmenu or is_custmenu or is_optionsmenu or is_learnmenu or is_readmenu or is_gallery or is_namemenu or menu_question!="") return;
if (!menu.running and !keyhelp and menu_question=="" and is_game and oldpaused) stop_menu_music();
if (!oldpaused)
{
if (is_custmenu) silence_custmenu();
resume();
oldpaused=false;
}
}

void set_selection()
{
uint8 cursel=selection;
if (cursel == selection_unspecified) cursel=1;
if (get_stat ("normal_played_total")==0 or is_tutorial or (!is_optionsmenu and selection==selection_unspecified)) speak_menu_prompt=true;
cursel=make_menu (selection_menu, cursel);
if (speak_menu_prompt!=old_prompt) speak_menu_prompt=old_prompt;
if (cursel!=selection) clear_drinks();
if (cursel>selection_unspecified) selection=cursel;
}

bool game_menu()
{
bool first=true;
while (true)
{
string[] hm={"Nabídka hry"};
hm.reserve (20);
hm.insert_last ("difficulty|Obtížnost: "+diff[difficulty]+"| |1|2|1");
hm.insert_last ("tutorial|První seznámení se hrou|Dokud tohoto průvodce nedokončíš, nemůžeš toto nastavení vypnout a začít tak hrát opravdu na ostro (než přidám obchod, tak ještě můžeš). Seznámení se hrou nefunguje společně s nekonečnou, volnou ani hardcore hrou. Samotné hraní tutoriálu je ještě pořád rozbité.|1|"+is_tutorial+"|0|"+(hardcore or endless or freeplay));
if (!is_tutorial)
{
hm.insert_last ("endless|Nekonečná hra|Hra nikdy neskončí výhrou, ale dřív nebo později nakonec stejně prohraješ. Nekonečnou hru nejde kombinovat s volnou hrou.|1|"+endless+"|0|"+freeplay);
hm.insert_last ("hardcore|Hardcore hra|Jestli už je na tebe obyčejná hra moc lehká, můžeš si níže zapnout další omezení navíc oproti normální hře. Hardcore hru můžeš kombinovat se všemi režimy kromě volné hry.|1|"+hardcore+"|0|"+freeplay);
hm.insert_last ("freeplay|Volná hra|Uvolněná hra, ve které o nic nejde a jen tak si užíváš atmosféru. Hra v tomto režimu nemá žádné časové omezení, takže nikdy neskončí sama od sebe, zákazníci mají nekonečnou trpělivost a hra na rozdíl od ostatních režimů nehlídá, jestli je obsluhuješ. Zároveň si můžeš nastavit, jestli zákazníci smí zvracet, zakopávat, usnout nebo začít dělat bordel, když se ožerou. Ale pozor, ve volné hře zákazníci nikdy nic neplatí. Volná hra nejde kombinovat s nekonečnou hrou, protože už stejně nekonečná je, jen má jiná pravidla, ani s hardcore hrou.|1|"+freeplay+"|0|"+(endless or hardcore));
if (freeplay)
{
hm.insert_last ("allow_sleeping|Zákazníci můžou usínat| |2|"+free_sleep);
hm.insert_last ("allow_tripping|Zákazníci můžou zakopávat|Zákazníci, kteří pijí nealko, nezakopávají nikdy.|2|"+free_trip);
hm.insert_last ("allow_puking|Zákazníci můžou zvracet| |2|"+free_puke);
hm.insert_last ("allow_roaming|Ožralí zákazníci můžou začít dělat bordel| |2|"+free_roam);
}
if (hardcore)
{
hm.insert_last ("allow_helpers|Povolit pomocníky| |3|"+allow_helpers);
hm.insert_last ("allow_servers|Na točení| |3|"+allow_servers+"|0|"+!allow_helpers);
hm.insert_last ("allow_givers|Na roznášení pití| |3|"+allow_givers+"|0|"+!allow_helpers);
hm.insert_last ("allow_cleaners|Na odnášení špinavých půllitrů| |3|"+allow_cleaners+"|0|"+!allow_helpers);
hm.insert_last ("allow_emptiers|Na odnášení prázdných sudů| |3|"+allow_emptiers+"|0|"+!allow_helpers);
hm.insert_last ("allow_barrelers|Na nošení nových sudů| |3|"+allow_barrelers+"|0|"+!allow_helpers);
hm.insert_last ("allow_bouncers|Na vyhazování ožralů| |3|"+allow_throwers+"|0|"+!allow_helpers);
hm.insert_last ("allow_calmers|Na pacifikování agresivních zákazníků| |3|"+allow_calmers+"|0|"+!allow_helpers);
hm.insert_last ("gameover_trip|Když zakopneš| |4|"+!allow_trips);
hm.insert_last ("gameover_fall|Když spadneš ze schodů| |4|"+!allow_falls);
hm.insert_last ("gameover_fled|Když odejde nespokojený zákazník| |4|"+!allow_fled);
hm.insert_last ("gameover_mistake|Když někoho obsloužíš špatně| |4|"+!allow_mistakes);
hm.insert_last ("gameover_leave_all|Když odejdou všichni zákazníci kvůli nepořádku| |4|"+!allow_messy);
hm.insert_last ("gameover_hit_customer|Když praštíš zákazníka| |4|"+!allow_stunned);
hm.insert_last ("gameover_hit_player|Když tě někdo praští| |4|"+!allow_playerhits);
hm.insert_last ("gameover_break_mug|Když se rozbije půllitr| |4|"+!allow_broken);
hm.insert_last ("gameover_break_barrel|Když se rozbije sud| |4|"+!allow_fallen);
}
}
hm.insert_last ("other_options|Ostatní nastavení hry|Na které události během hry chceš dostávat slovní upozornění. Většina plánovaných nastavení tohoto typu zatím chybí.|5|2|1");
string start="start|Spustit ";
if (is_tutorial) start+="seznámení se hrou";
else
{
if (endless) start+="nekonečnou ";
else if (freeplay) start+="volnou ";
else start+="normální ";
if (hardcore) start+="hardcore ";
start+="hru";
}
start+=" na "+diff4[difficulty-1]+" obtížnost|";
if (hardcore or freeplay)
{
string game=say_game(false);
start+=game;
if (game=="" or game==" ") start+=" ";
}
else start+=" ";
start+="|5";
hm.insert_last (start);
string[] secs={"Režim hry", "Nastavení volné hry", "Pomocníci v hardcore hře", "Kdy končí hardcore hra prohrou", ""};
int8 tempres=make_menu (hm, gameres, menu, first, secs, !first);
first=false;
if (tempres==0) return false;
gameres=tempres;
string itn=menu.get_item_name (gameres);
if (instr (itn, "start"))
{
if (hardcore and allow_helpers and !allow_servers and !allow_givers and !allow_cleaners and !allow_barrelers and !allow_emptiers and !allow_throwers and !allow_calmers)
{
play_stat ("error");
say ("V hardcore hře nemáš povolený žádný typ pomocníků. Buď některé z nich povol, nebo zakaž samotnou možnost pomocníků jako takovou.", true, false, true);
first=true;
}
else if ((!allow_mistakes and !allow_fled and !allow_stunned) or (!allow_stunned and !allow_trips and !allow_falls and !allow_broken and !allow_fallen))
{
if (ask ("S touto kombinací omezení bude hardcore hra pravděpodobně nedohratelná. Chceš ji hrát i tak?") ==1) break;
else first=true;
}
else if (hardcore and allow_helpers and allow_servers and allow_givers and allow_cleaners and allow_emptiers and allow_barrelers and allow_throwers and allow_calmers and allow_trips and allow_falls and allow_broken and allow_fallen and allow_fled and allow_stunned and allow_messy and allow_mistakes and allow_playerhits)
{
play_stat ("error");
say ("V hardcore hře nemáš nastavená vůbec žádná omezení nad rámec běžné hry. Buď některé z nich zapni, nebo vypni i samotnou hardcore hru jako takovou.", true, false, true);
first=true;
}
else break;
}
else
{
if (instr (itn, "helpers")) allow_helpers=!allow_helpers;
else if (instr (itn, "servers")) allow_servers=!allow_servers;
else if (instr (itn, "givers")) allow_givers=!allow_givers;
else if (instr (itn, "cleaners")) allow_cleaners=!allow_cleaners;
else if (instr (itn, "emptiers")) allow_emptiers=!allow_emptiers;
else if (instr (itn, "barrelers")) allow_barrelers=!allow_barrelers;
else if (instr (itn, "bouncers")) allow_throwers=!allow_throwers;
else if (instr (itn, "calmers")) allow_calmers=!allow_calmers;
else if (instr (itn, "over_trip")) allow_trips=!allow_trips;
else if (instr (itn, "fall")) allow_falls=!allow_falls;
else if (instr (itn, "leave")) allow_messy=!allow_messy;
else if (instr (itn, "break_barrel")) allow_fallen=!allow_fallen;
else if (instr (itn, "mug")) allow_broken=!allow_broken;
else if (instr (itn, "mistake")) allow_mistakes=!allow_mistakes;
else if (instr (itn, "customer")) allow_stunned=!allow_stunned;
else if (instr (itn, "player")) allow_playerhits=!allow_playerhits;
else if (instr (itn, "fled")) allow_fled=!allow_fled;
else if (instr (itn, "diff"))
{
set_difficulty();
first=true;
}
else if (instr (itn, "tutorial")) is_tutorial=!is_tutorial;
else if (instr (itn, "selection"))
{
set_selection();
first=true;
}
else if (instr (itn, "clear_drinks"))
{
clear_drinks();
first=true;
}
else if (instr (itn, "choose"))
{
choose_beers_manually();
first=true;
}
else if (instr (itn, "other"))
{
game_options();
first=true;
}
else if (instr (itn, "endless")) endless=!endless;
else if (instr (itn, "free")) freeplay=!freeplay;
else if (instr (itn, "hardcore")) hardcore=!hardcore;
else if (instr (itn, "allow_sleeping")) free_sleep=!free_sleep;
else if (instr (itn, "allow_tripping")) free_trip=!free_trip;
else if (instr (itn, "allow_puking")) free_puke=!free_puke;
else if (instr (itn, "allow_roaming")) free_roam=!free_roam;
}
}
return true;
}

void wait_answered (bool play_sound=true)
{
if (!onboarding and play_sound and !is_game) play_enter();
reset_ui_help();
}

void ui_help (bool speak)
{
if (@top_menu is null or (speak and help_read) or (speak and !speak_ui_help)) return;
string msg="";
ui_help_timer.restart();
ui_help_timer.pause();
bool old_help=speak_ui_help;
if (!speak) speak_ui_help=false;
msg="Šipka dolů, šipka doprava nebo tab: Následující ";
if (is_readmenu and !is_custmenu) msg+="řádek";
else if (menu_question!="") msg+="odpověď";
else if (is_custmenu and !is_readmenu) msg+="zákazník";
else msg+="položka";
msg+=".\r\nŠipka nahoru, šipka doleva nebo šift plus tab: Předchozí ";
if (is_readmenu and !is_custmenu) msg+="řádek";
else if (menu_question!="") msg+="odpověď";
else if (is_custmenu and !is_readmenu) msg+="zákazník";
else msg+="položka";
msg+=".\r\n";
if (@top_menu!=null and top_menu.has_sections()>1) msg+="Kontrol plus šipka dolů, kontrol plus šipka doprava nebo kontrol plus tab: Následující záložka.\r\nKontrol plus šipka nahoru, kontrol plus šipka doleva nebo kontrol plus šift+tab: Předchozí záložka.\r\n";
msg+="Mezerník: Zopakování ";
if (is_readmenu and !is_custmenu) msg+="aktuálního řádku.\r\n";
else if (menu_question!="") msg+="znění otázky a vybrané odpovědi.\r\n";
else if (is_custmenu) msg+="informací o vybraném zákazníkovi.\r\n";
else msg+="vybrané položky.\r\n";
if (is_learnmenu) msg+="Enter: Přehrání vybraného zvuku. Pokud má zvuk víc variant, budou se přehrávat náhodně.\r\n";
else if (!is_readmenu and is_custmenu) msg+="Enter: Nabídka akcí pro vybraného zákazníka.\r\n";
else if (!is_statmenu)
{
if (menu_question!="") msg+="Enter: Potvrzení vybrané odpovědi.\r\n";
else if (is_readmenu and !is_custmenu and @top_menu!=null and top_menu.get_item_description (top_menu.get_position())!="") msg+="Enter: Otevření vybraného odkazu.\r\n";
else if (!is_readmenu and !is_custmenu) msg+="Enter: Potvrzení vybrané položky.\r\n";
}
msg+="Houm: ";
if (is_readmenu and !is_custmenu) msg+="První řádek.\r\n";
else if (menu_question!="") msg+="První odpověď.\r\n";
else if (is_custmenu and !is_readmenu) msg+="zákazník";
else msg+="První položka.\r\n";
msg+="End: ";
if (is_readmenu and !is_custmenu) msg+="Poslední řádek.\r\n";
else if (menu_question!="") msg+="Poslední odpověď.\r\n";
else if (is_custmenu and !is_readmenu) msg+="zákazník";
else msg+="Poslední položka.\r\n";
if (@top_menu!=null and top_menu.get_item_count()>10)
{
msg+="Pejdž ap: Skok o 10 ";
if (is_readmenu and !is_custmenu) msg+="řádků";
else if (is_custmenu and !is_readmenu) msg+="zákazníků";
else msg+="položek";
msg+=" nahoru.\r\nPejdž daun: Skok o 10 ";
if (is_readmenu and !is_custmenu) msg+="řádků";
else if (is_custmenu and !is_readmenu) msg+="zákazníků";
else msg+="položek";
msg+=" dolů.\r\n";
}
if (is_custmenu and !is_readmenu) msg+="Kontrol plus er: Zobrazení informací o vybraném zákazníkovi v seznamu pro pohodlnější čtení.\r\n";
if (@top_menu!=null and top_menu.item_list[0].name=="play") msg+="Eskejp nebo alt plus ef čtyři: Ukončení programu.\r\n";
else
{
if (!onboarding and (menu_question=="" or (@top_menu!=null and top_menu.get_item_count()==3))) msg+="Eskejp nebo bekspejs: Návrat do předchozí nabídky.\r\n";
if (menu_question!="Ukončit program?") msg+="Alt plus ef čtyři: Ukončení programu.\r\n";
}
msg+="Písmena abecedy: ";
if (menu_question=="")
{
msg+="Rychlá navigace na nejbližší";
if (is_readmenu and !is_custmenu) msg+=" řádek";
else if (is_custmenu and !is_readmenu) msg+="ho zákazníka";
else msg+=" položku";
msg+=" začínající";
if (is_custmenu and !is_readmenu) msg+="ho";
msg+=" daným písmenem.\r\n";
}
else msg+="Rychlý výběr konkrétní odpovědi.\r\n";
if (is_readmenu and msg!=read_text) msg+="Kontrol plus cé: Zkopírování celého seznamu do schránky.\r\n";
if (!is_readmenu) msg+="Ef jedna: Zobrazení kontextové nápovědy k ovládání této obrazovky v seznamu pro pohodlnější čtení.\r\n";
msg+="Dylít nebo kontrol plus šift plus alt: Umlčení řeči.";
if (speak and !help_read)
{
say (msg, false, false, false);
help_read=true;
ui_help_timer.restart();
ui_help_timer.pause();
}
else if (!speak and read_text!=msg)
{
wait_keys();
string old_text=read_text;
read_menu (msg);
help_read=true;
ui_help_timer.restart();
ui_help_timer.pause();
read_text=old_text;
}
speak_ui_help=old_help;
}

void ui_options()
{
silence();
dynamic_menu tempmenu;
int8 tempres=-1;
string item="";
bool first=true;
while (tempres==-1 or tempres != 0)
{
uint8[] outputs;
outputs.reserve (4);
if (SCREEN_READER_AVAILABLE) outputs.insert_last (1);
string[] optmenu={""};
if (tempres == -1 and speak_menu_prompt) optmenu[0]="Nastavení rozhraní";
optmenu.insert_last ("check_updates|Kontrolovat aktualizace při spuštění|Pokud toto nastavení vypneš, budeš muset aktualizovat ručně z hlavního menu a podnabídky Online funkce.|1|"+updates);
optmenu.insert_last ("pause_on_blur|Zapauzovat hru při přepnutí do jiného okna|Při návratu do okna hry ji budeš muset ručně odpauzovat|1|"+pause_on_blur);
optmenu.insert_last ("show_empty_stats|Zobrazovat statistiky s nulovou hodnotou|Vypnutím tohoto nastavení skryješ v nabídce Statistiky všechny položky, které ještě nemají žádný záznam. Toto nastavení má vliv i na kopírování statistik do schránky.|1|"+show_empty_stats);
optmenu.insert_last ("speak_menu_prompt|Při otevření nabídky oznámit její název|Pokud máš zároveň zapnuté čtení pozic položek, oznámí se při otevření nabídky i počet záložek.|2|"+speak_menu_prompt);
optmenu.insert_last ("speak_menu_position|Číst pozice položek| |2|"+speak_menu_position);
optmenu.insert_last ("speak_submenu|Slovní upozornění, že položka má podnabídku| |2|"+speak_submenu);
optmenu.insert_last ("menu_wrap|Cyklické nabídky|Přehled všech zákazníků, seznam pro pohodlnější čtení a nabídka při odpovědi na otázku nejsou cyklické nikdy.|2|"+menu_wrap);
optmenu.insert_last ("speak_ui_help|Číst kontextovou nápovědu k ovládání|Pokud je toto nastavení zapnuté a určitou dobu nestiskneš v některé nabídce žádnou klávesu, jednou se automaticky přečtou klávesové zkratky pro ovládání dané obrazovky. Tyto zkratky si také můžeš kdykoli zobrazit v seznamu pro pohodlnější čtení klávesou ef jedna.|2|"+speak_ui_help);
optmenu.insert_last ("set_ui_help_delay|Prodleva před přečtením kontextové nápovědy k ovládání");
optmenu[optmenu.length()-1]+=": ";
uint uhd=round (ui_help_delay/1000, 0);
if (uhd==1) optmenu[optmenu.length()-1]+="jedna vteřina";
else if (uhd<5) optmenu[optmenu.length()-1]+=uhd+" vteřiny";
else optmenu[optmenu.length()-1]+=uhd+" vteřin";
if (!speak_ui_help) optmenu[optmenu.length()-1]+="|Nelze měnit, když je vypnuté automatické čtení kontextové nápovědy.";
else optmenu[optmenu.length()-1]+="| ";
optmenu[optmenu.length()-1]+="|2|2|1|"+!speak_ui_help;
optmenu.insert_last ("use_speech_history|Používat historii řeči|Když toto nastavení vypneš, nebudeš mít při hře jak zopakovat hlášky, které napoprvé přeslechneš.|3|"+use_history);
string current_history_size="speech_history_size|Maximální počet položek v historii: ";
if (history_entries==0) current_history_size+="neomezený";
else current_history_size+=history_entries;
current_history_size+="| |3|2|1|"+!use_history;
optmenu.insert_last (current_history_size);
optmenu.insert_last ("reset_speech_history|Mazat historii při spuštění nové hry| |3|"+reset_history+"|0|"+!use_history);
optmenu.insert_last ("copy_speech_history|Kopírovat historii do schránky při ukončení programu| |3|"+copy_history+"|0|"+!use_history);
optmenu.insert_last ("save_speech_history|Ukládat historii do souboru při ukončení programu|Soubor s názvem speech_history.txt se vytvoří ve stejné složce, odkud hru spouštíš.|3|"+save_history+"|0|"+!use_history);
optmenu.insert_last ("speak_confirm_screen_reader_prompt|Slovní výzva k pokračování|Pokud hra mluví prostřednictvím odečítače, není na některých místech možné pokračovat k dalšímu kroku bez potvrzení enterem. V nabídce nastavení zvuku si můžeš ještě zvlášť nastavit zvukové upozornění místo slovního.|4|"+speak_sr_prompt+"|0|"+forced_output);
if (!outputs.is_empty()) optmenu.insert_last ("force_screen_reader|Číst systémovým hlasem|Pokud je toto nastavení vypnuté, hra bude všechno říkat prostřednictvím odečítače.|4|"+forced_output);
if (system_is_windows) optmenu.insert_last ("sapi_settings|Nastavení systémového hlasu|Otevře systémový ovládací panel, kde můžeš nastavit parametry hlasu.|4|2|0|"+!forced_output);
optmenu.insert_last ("echo_chars|Hlásit psané znaky| |5|"+input.echo_chars);
optmenu.insert_last ("echo_words|Hlásit psaná slova| |5|"+input.echo_words);
optmenu.insert_last ("echo_smart|Chytrá odezva|Pokud je toto nastavení zapnuté, přečte se všechno, co jsi napsal");
if (gender==2) optmenu[optmenu.length()-1]+="a";
optmenu[optmenu.length()-1]+=" od poslední odezvy, pokaždé, když na chvíli přestaneš psát.|5|"+input.echo_smart;
if (!onboarding) optmenu.insert_last ("restore_ui_defaults|Obnovit výchozí nastavení rozhraní| |6");
if (tempres == -1) tempres=1;
string[] secs={"Obecné", "Nabídky", "Historie řeči", "Čtení", "Odezva při psaní", ""};
tempres=make_menu (optmenu, tempres, tempmenu, first, secs, !first);
first=false;
item=tempmenu.get_item_name (tempres);
if (instr (item, "menu_prompt"))
{
speak_menu_prompt=!speak_menu_prompt;
old_prompt=speak_menu_prompt;
}
else if (instr (item, "menu_position")) speak_menu_position=!speak_menu_position;
else if (instr (item, "menu_wrap")) menu_wrap=!menu_wrap;
else if (instr (item, "submenu")) speak_submenu=!speak_submenu;
else if (instr (item, "speak_ui_help")) speak_ui_help=!speak_ui_help;
else if (instr (item, "ui_help_delay"))
{
set_ui_help_delay();
first=true;
}
else if (instr (item, "use_speech_history")) use_history=!use_history;
else if (instr (item, "history_size"))
{
set_history_size();
first=true;
}
else if (instr (item, "reset_speech_history")) reset_history=!reset_history;
else if (instr (item, "copy_speech_history")) copy_history=!copy_history;
else if (instr (item, "save_speech_history")) save_history=!save_history;
else if (instr (item, "speak_confirm_screen")) speak_sr_prompt=!speak_sr_prompt;
else if (instr (item, "blur")) pause_on_blur=!pause_on_blur;
else if (instr (item, "empty_stats")) show_empty_stats=!show_empty_stats;
else if (instr (item, "force_screen_reader"))
{
forced_output=!forced_output;
silence();
checkup();
if (output==0)
{
changed_output();
say ("Zapnuto", true, false, false);
}
else if (reader_name=="NVDA")
{
say_sleep_mode();
first=true;
}
}
else if (instr (item, "sapi")) set_tts_voice();
else if (instr (item, "echo_chars")) input.echo_chars=!input.echo_chars;
else if (instr (item, "echo_words")) input.echo_words=!input.echo_words;
else if (instr (item, "echo_smart")) input.echo_smart=!input.echo_smart;
else if (instr (item, "update")) updates=!updates;
else if (instr (item, "restore"))
{
restore_ui_defaults (false);
return;
}
else if (instr (item, "continue")) break;
}
}

void restore_ui_defaults (bool silent)
{
speak_menu_prompt=true;
old_prompt=true;
speak_menu_position=true;
menu_wrap=false;
speak_ui_help=true;
ui_help_delay=5*1000;
use_history=true;
history_entries=100;
reset_history=true;
copy_history=false;
save_history=false;
speak_sr_prompt=true;
forced_output=false;
checkup();
pause_on_blur=true;
show_empty_stats=false;
input.reset (true);
speak_submenu=true;
enable_logging=false;
updates=true;
if (!silent) say ("Výchozí nastavení rozhraní obnovena.", true, false, true);
}

void set_history_size()
{
wait_keys();
silence();
reset_ui_help();
say ("Zadej číslem maximální velikost historie řeči. 0 znamená neomezenou velikost.", true, false);
input.set_text (""+history_entries);
input.numbers_only=true;
string inp=input.run (5);
silence();
play_enter();
if (inp=="")
{
if (is_game and !menuloop.playing and paused and !play_menu_sounds) say ("Zrušeno.", true, false);
return;
}
int inpn=int(parse_int(inp));
if (!inp.is_digits() or inpn<0 or inpn>10000)
{
play_stat ("error");
say ("Můžeš zadat pouze číslo od 0 do 10000.", true, false);
return;
}
history_entries=inpn;
input.numbers_only=false;
}

void set_ui_help_delay()
{
silence();
dynamic_menu subtemp;
int8 subtempres=make_menu (help_items, help_values.find(round (ui_help_delay/1000, 0))+1, subtemp);
if (subtempres>0) ui_help_delay=help_values[subtempres-1]*1000;
}

double set_volume (double vol)
{
silence();
dynamic_menu temp;
int8 tempres=make_menu (volmenu_items, (volmenu_values.find(vol)+1), temp);
if (tempres>0) return volmenu_values[tempres-1];
return vol;
}

double set_stereo (double which, uint8 boundary, string prompt)
{
string helpmsg="Šipka dolů, šipka doprava nebo tab: Posunutí hodnoty doprava.\r\nŠipka nahoru, šipka doleva nebo šift plus tab: Posunutí hodnoty doleva.\r\nMezerník: Zopakování zvuku pro aktuální hodnotu.\r\nDylít nebo bekspejs: Obnovení výchozí hodnoty.\r\nHoum: Posunutí hodnoty na levý okraj stereopole.\r\nEnd: Posunutí hodnoty na pravý okraj stereopole.\r\nEnter: Uložení aktuální hodnoty.\r\nEskejp: Zrušení změn.\r\nAlt plus ef čtyři: Ukončení programu.\r\nEf jedna: Zobrazení těchto zkratek v seznamu pro pohodlnější čtení.\r\nDylít nebo kontrol plus šift plus alt: Umlčení řeči.";
double temp=which;
sound ping, edge;
ping.stream ("turn"+ext);
edge.stream ("edge"+ext);
say ("Nastav novou hodnotu pro "+prompt+".", true, false);
bool tab, moved=false;
reset_ui_help();
while(true)
{
wait(5);
if (speak_ui_help)
{
if (down_keys()>0 and ui_help_timer.elapsed<ui_help_delay) ui_help_timer.restart();;
if (ui_help_timer.elapsed>=ui_help_delay and down_keys()==0 and !help_read)
{
say (helpmsg, true, false);
help_read=true;
ui_help_timer.restart();
ui_help_timer.pause();
}
}
menu_music();
closekey();
tab=key_pressed (KEY_TAB);
if (singlekey (KEY_ESCAPE))
{
play_esc();
if (is_game and paused and !menuloop.playing and !play_menu_sounds) say ("Zrušeno.", true, false);
reset_ui_help();
return which;
}
else if (singlekey (KEY_RETURN) or singlekey (KEY_NUMPAD_ENTER))
{
play_enter();
break;
}
else if (singlekey (KEY_SPACE)) moved=true;
else if (singlekey (KEY_BACK) or singlekey (KEY_DELETE))
{
temp=which;
moved=true;
}
else if (singlekey (KEY_F1))
{
read_menu (helpmsg);
help_read=true;
ui_help_timer.restart();
ui_help_timer.pause();
}
else if ((key_pressed (KEY_DOWN) or key_pressed (KEY_RIGHT) or tab) and down_keys()==1)
{
temp+=step_size;
moved=true;
}
else if ((key_pressed (KEY_UP) or key_pressed (KEY_LEFT) or (tab and mod_shift())) and !mod_ctrl() and !mod_alt() and down_keys()<=2)
{
temp-=step_size;
moved=true;
}
else if (singlekey (KEY_HOME))
{
if (which==stereo_center) temp=stereo_left+step_size;
else temp=left_edge;
moved=true;
}
else if (singlekey (KEY_END))
{
if (which==stereo_center) temp=stereo_right-step_size;
else temp=right_edge;
moved=true;
}
if (moved)
{
silence();
switch (boundary)
{
case 0:
if (temp<left_edge)
{
edge.pan=temp;
if (edge.playing) edge.stop();
edge.play();
temp=left_edge;
moved=false;
}
if (temp>=stereo_center)
{
play_stat ("error");
say ("Levý okraj stereopole musí být vlevo od středu.", true, false);
temp=stereo_center-step_size;
moved=false;
}
break;
case 1:
if (temp<=stereo_left)
{
play_stat ("error");
say ("Střed stereopole musí být vpravo od levého okraje.", true, false);
temp=stereo_left+step_size;
moved=false;
}
if (temp>=stereo_right)
{
play_stat ("error");
say ("Střed stereopole musí být vlevo od pravého okraje.", true, false);
temp=stereo_right-step_size;
moved=false;
}
break;
case 2:
if (temp>=right_edge)
{
edge.pan=temp;
if (edge.playing) edge.stop();
edge.play();
temp=right_edge-step_size;
moved=false;
}
if (temp<=stereo_center)
{
play_stat ("error");
say ("Pravý okraj stereopole musí být vpravo od středu.", true, false);
temp=stereo_center+step_size;
moved=false;
}
break;
}
if (moved)
{
if (ping.playing) ping.stop();
ping.pan=temp;
ping.play();
moved=false;
}
}
}
reset_ui_help();
return temp;
}

void control_options()
{
silence();
dynamic_menu tempmenu;
int8 tempres=-1;
string item="";
while (tempres == -1 or tempres != 0)
{
string[] optmenu={""};
if (tempres == -1 and speak_menu_prompt) optmenu[0]="Nastavení ovládání";
optmenu.insert_last ("keyhelp|Klávesová nápověda|Každá klávesa, kterou stiskneš, řekne, co dělá při hře. Během samotné hry můžeš tuto nápovědu kdykoli otevřít klávesou ef jedna.");
optmenu.insert_last ("view_controls|Zobrazit ovládání| |1|2|1");
optmenu.insert_last ("remap|Přemapovat ovládání|Zatím nic nedělá.|1|2|1");
if (!onboarding) optmenu.insert_last ("restore_control_defaults|Obnovit výchozí ovládání|Zatím nic nedělá.");
if (tempres == -1) tempres=1;
tempres=make_menu (optmenu, tempres, tempmenu);
item=tempmenu.get_item_name (tempres);
if (instr (item, "keyhelp"))
{
help();
tempmenu.speak_item=true;
}
else if (instr (item, "view"))
{
view_controls();
tempmenu.speak_item=true;
}
else if (instr (item, "continue")) break;
}
}

void view_controls()
{
uint l=shortcuts.length();
string[] commands;
commands.reserve (l);
uint8 section=1;
string[] sections={"Ovládání programu", "Pohyb a interakce", "Obecné informace", "Informace o zákaznících", "Informace o půllitrech", "Informace o sudech", "Informace o frontě", "Sledování zákazníků", "Kdo si co objednal", "Pojmenování zákazníků", "Historie řeči"};
for (uint i=0; i<l; i++)
{
if (shortcuts[i].section>section) section++;
string entry=shortcuts[i].ui_name+"|"+shortcuts[i].name+": "+shortcuts[i].combo;
if (shortcuts[i].combo2!=" " and shortcuts[i].combo2!="") entry+=" nebo "+shortcuts[i].combo2;
if ((shortcuts[i].desc!="" and shortcuts[i].desc!=" ") or (shortcuts[i].longdesc!="" and shortcuts[i].longdesc!=" "))
{
entry+="|";
if (shortcuts[i].desc!="" and shortcuts[i].desc!=" ")
{
entry+=shortcuts[i].desc;
if (shortcuts[i].longdesc!="" and shortcuts[i].longdesc!=" ") entry+=" ";
}
if (shortcuts[i].longdesc!="" and shortcuts[i].longdesc!=" ") entry+=shortcuts[i].longdesc;
}
else entry+="| ";
entry+="|"+section;
commands.insert_last (entry);
}
commands.insert_at (0, "Přehled ovládání");
is_readmenu=true;
make_menu (commands, 1, menu, true, sections);
is_readmenu=false;
}

void profile_options()
{
silence();
dynamic_menu tempmenu;
int8 tempres=1;
string item="";
while (true)
{
string[] optmenu={""};
optmenu[0]="Nastavení profilu";
optmenu.insert_last ("gender|Pohlaví: "+genders[gender].split("|", true)[1]+"|Určuje, v jakém mluvnickém rodě tě bude hra oslovovat. Možnost neuvedeno předpokládá mužský rod.|1|2|1");
string date_desc="|Kdo ví, třeba se ti to bude k něčemu hodit. Toto datum už po dokončení nastavení nepůjde změnit.";
string ndi="nameday|";
if (onboarding) ndi+="Zadat, kdy máš svátek";
else ndi+="Svátek";
if (name_day>0 and name_month>0) ndi+=": "+days[name_day-1]+" "+months[name_month-1];
if (onboarding) ndi+=date_desc;
else ndi+="| ";
ndi+="|1|2|1|"+!onboarding;
optmenu.insert_last (ndi);
string nbi="birthday|";
if (onboarding) nbi+="Zadat, kdy máš narozeniny";
else nbi+="Narozeniny";
if (birth_day>0 and birth_month>0) nbi+=": "+days[birth_day-1]+" "+months[birth_month-1];
if (onboarding) nbi+=date_desc;
else nbi+="| ";
nbi+="|1|2|1|"+!onboarding;
optmenu.insert_last (nbi);
if (!onboarding and profile.exists ("created_day"))
{
string created="created_date|Datum vytvoření profilu: "+days[created_day-1]+" "+months[created_month-1]+" "+created_year+", "+created_hour+":";
if (created_minute<10) created+="0"+created_minute;
else created+=created_minute;
created+="| |1|2|0|1";
optmenu.insert_last (created);
}
if (!onboarding) optmenu.insert_last ("clear_profile|Smazat profil|"+clear_profile_description+"|1|2|1|"+!file_exists (folder+"profile.dat"));
tempres=make_menu (optmenu, tempres, tempmenu);
if (tempres==0)
{
if (!check_profile())
{
play_stat ("error");
say ("Před pokračováním prosím vyplň, kdy máš svátek a narozeniny, protože později už nebudeš mít možnost tyto údaje změnit.", true, false, true);
tempres=1;
continue;
}
else break;
}
item=tempmenu.get_item_name (tempres);
if (instr (item, "gender")) gender=set_gender();
else if (instr (item, "nameday")) set_date (false);
else if (instr (item, "birthday")) set_date (true);
else if (instr (item, "clear")) clear_profile();
}
}

uint8 set_gender()
{
silence();
dynamic_menu subtempmenu;
int8 subtempres=make_menu (genders, gender, subtempmenu);
if (subtempres>0) return subtempres;
return gender;
}

void game_options()
{
silence();
dynamic_menu tempmenu;
tempmenu.set_callback (callback, "");
string item="";
int8 tempres=-1;
bool first=true;
string[] sections={"Obecné", "Jukebox", "Oznámení během hry", ""};
while (tempres==-1 or tempres!=0)
{
string[] optmenu={""};
if (tempres==-1 and speak_menu_prompt) optmenu[0]="Nastavení hry";
optmenu.insert_last ("opt_set_drink_selection|Jak vybrat piva na čepu");
if (selection!=selection_unspecified) optmenu[optmenu.length()-1]+=": "+selection_menu[selection].substr (selection_menu[selection].find("|")+1).lower();
optmenu[optmenu.length()-1]+="|Určuje, jestli se piva, která chceš mít na čepu, budou měnit každou hru a jestli je vybereš ručně, nebo se vyberou náhodně. Toto nastavení nelze měnit během hry.|1|2|1|"+is_game;
if (!beers.is_empty()) optmenu.insert_last ("opt_clear_drinks|Smazat vybraná piva|Nelze během hry a pokud se vybírají náhodně.|1|2|0|"+(is_game or selection==selection_random_change or selection==selection_manual_change));
else optmenu.insert_last ("choose_drinks|Vybrat piva|Nelze během hry a pokud se vybírají náhodně.|1|2|1|"+(is_game or selection==selection_random_change or selection==selection_manual_change or selection==selection_unspecified));
optmenu.insert_last ("name_customers|Dávat některým zákazníkům náhodná jména| |1|"+name_customers);
optmenu.insert_last ("show_lose_tips|Při každé prohře zobrazit jeden náhodný tip|Všechny tipy si můžeš kdykoli přečíst položkou Zobrazit tipy, jak hrát, z hlavního menu|1|"+show_tips);
string no_jukebox=" Toto nastavení teď měnit nemůžeš, protože máš v nabídce nastavení zvuku zakázané přehrávání veškeré hudby z jukeboxu.";
optmenu.insert_last ("random_music|Přehrávat náhodné písničky|Když je toto nastavení vypnuté, nebude z jukeboxu hrát žádná hudba, dokud někdo nepustí nějakou konkrétní písničku. Až dohrají všechny písničky, které jste pustili ty nebo zákazníci, přestane jukebox hrát.");
if (!play_game_music) optmenu[optmenu.length()-1]+=no_jukebox;
optmenu[optmenu.length()-1]+="|2|"+play_random_music+"|0|"+!play_game_music;
optmenu.insert_last ("customers_jukebox|Zákazníci smějí pouštět hudbu|Když je toto nastavení vypnuté a zároveň je vypnutá i náhodná hudba, nebude z jukeboxu nikdy samo od sebe hrát nic. Ty z něj ale můžeš něco pustit kdykoliv, pokud na to máš peníze.");
if (!play_game_music) optmenu[optmenu.length()-1]+=no_jukebox;
optmenu[optmenu.length()-1]+="|2|"+enable_jukebox+"|0|"+!play_game_music;
optmenu.insert_last ("speak_impatient|Zákazník brzy ztratí trpělivost| |3|"+say_impatient);
optmenu.insert_last ("speak_errors|Slovní popisy chyb|Pokud je toto nastavení vypnuté, ozve se vždycky, když se pokusíš udělat něco, co zrovna nejde - jako třeba sebrat další půllitr, když už jich neseš sedm - jen zvuková výstraha. Příslušný zvuk najdeš v nabídce seznámení se zvuky.|3|"+speak_errors);
optmenu.insert_last("speak_step|Předměty při chůzi|Když je toto nastavení vypnuté a ty budeš chtít zjistit, jestli jsou na políčku, kde právě stojíš, nějaké půllitry nebo sudy, budeš to muset udělat pokaždé ručně.|3|"+speak_step);
if (!onboarding)
{
optmenu.insert_last ("restore_game_defaults|Obnovit výchozí nastavení hry");
if (is_game) optmenu[optmenu.length()-1]+="|Obtížnost, režim hry a způsob vybírání piv na čepu nemůžeš měnit během hry.";
else optmenu[optmenu.length()-1]+="| ";
optmenu[optmenu.length()-1]+="|4";
}
if (tempres == -1) tempres=1;
tempres=make_menu (optmenu, tempres, tempmenu, first, sections, !first);
first=false;
item=tempmenu.get_item_name (tempres);
if (instr (item, "step")) speak_step=!speak_step;
else if (instr (item, "error")) speak_errors=!speak_errors;
else if (instr (item, "selection"))
{
set_selection();
first=true;
}
else if (instr (item, "clear_drinks"))
{
clear_drinks();
first=true;
}
else if (instr (item, "choose"))
{
choose_beers_manually();
first=true;
}
else if (instr (item, "name_customers")) name_customers=!name_customers;
else if (instr (item, "tips")) show_tips=!show_tips;
else if (instr (item, "impatient")) say_impatient=!say_impatient;
else if (instr (item, "random_music"))
{
play_random_music=!play_random_music;
if (!play_random_music and music>-1 and playlist.is_empty() and !repeat_playlist)
{
pool.destroy_sound (music);
music=-1;
last_track="";
}
}
else if (instr (item, "customers_jukebox")) enable_jukebox=!enable_jukebox;
else if (instr (item, "game_defaults"))
{
restore_game_defaults (false);
return;
}
else if (instr (item, "continue")) break;
}
}

void restore_game_defaults (bool silent)
{
speak_errors=true;
cue=true;
speak_step=true;
name_customers=true;
string results="Výchozí nastavení hry obnovena.";
if (!is_game)
{
difficulty=1;
selection=selection_unspecified;
clear_drinks();
allow_helpers=true;
allow_servers=true;
allow_givers=true;
allow_cleaners=true;
allow_emptiers=true;
allow_barrelers=true;
allow_calmers=true;
allow_throwers=true;
allow_trips=true;
allow_falls=true;
allow_messy=true;
allow_mistakes=true;
allow_fled=true;
allow_stunned=true;
allow_broken=true;
allow_fallen=true;
allow_playerhits=true;
hardcore=false;
endless=false;
freeplay=false;
free_sleep=true;
free_puke=true;
free_trip=true;
free_roam=true;
}
say_impatient=true;
show_tips=true;
play_random_music=true;
enable_jukebox=true;
if (!silent) say (results, true, false, true);
}

void audio_options()
{
silence();
dynamic_menu tempmenu;
tempmenu.set_callback (callback, "");
int8 tempres=-1;
string item="";
bool first=true;
while (tempres == -1 or tempres != 0)
{
string[] optmenu={""};
if (tempres == -1 and speak_menu_prompt) optmenu[0]="Nastavení zvuku";
optmenu.insert_last ("play_intro|Animace při spuštění programu| |1|"+play_intro);
optmenu.insert_last ("play_outro|Animace při ukončení programu| |1|"+play_outro);
optmenu.insert_last ("menu_sounds|Zvuky při pohybu v nabídkách| |1|"+play_menu_sounds);
optmenu.insert_last ("play_submenu|Zvukové upozornění, že položka má podnabídku|");
if (!play_menu_sounds) optmenu[optmenu.length()-1]+="Nelze přehrávat, když jsou vypnuté všechny zvuky při pohybu v nabídkách.";
else optmenu[optmenu.length()-1]+=" ";
optmenu[optmenu.length()-1]+="|1|"+play_submenu_sound+"|0|"+!play_menu_sounds;
optmenu.insert_last("play_logo|Logo při spuštění nové hry| |1|"+play_logo);
optmenu.insert_last("play_game_music|Hudba z jukeboxu|Pokud zakážeš hudbu z jukeboxu, nebudeš ty ani zákazníci moct ručně pouštět konkrétní vybrané písničky. Když toto nastavení necháš zapnuté, můžeš v nabídce nastavení hry zvlášť nastavit, jestli smí jukebox pouštět zákazníci a jestli má během celé hry hrát náhodnou hudbu.|1|"+play_game_music);
optmenu.insert_last ("play_menu_music|Hudba v nabídkách|Ovlivňuje i hudbu na závěrečné obrazovce na konci hry|1|"+play_menu_music);
optmenu.insert_last ("play_menu_music_in_game|Hudba v nabídkách i během hry|Například v kontextovém menu nebo v přehledu všech zákazníků|1|"+play_menu_music_in_game+"|0|"+!play_menu_music);
optmenu.insert_last ("play_mug_loop|Půllitry| |1|"+play_mugloop);
optmenu.insert_last ("play_barrel_loop|Sudy| |1|"+play_barrelloop);
optmenu.insert_last ("play_single_loop|Více předmětů na stejném místě|Když toto nastavení vypneš a na některém políčku budou například tři půllitry najednou, bude se z něj ozývat pouze jeden zvuk půllitru. Úplně se přestane ozývat, teprve až na tomto políčku nezůstanou žádné půllitry. Vypnutím tohoto nastavení tak můžeš docílit menšího hluku při hře, což může být někdy přehlednější.|1|"+play_all_items+"|0|"+(!play_mugloop and !play_barrelloop));
optmenu.insert_last ("customer_beep|První zákazník ve frontě nebo sledovaný zákazník|Pokud právě nikoho nesleduješ, bude se zvuk ozývat vždy jen poblíž toho zákazníka, který je zrovna první ve frontě. Pokud někoho sledovat začneš, bude se zvuk ozývat vždy jen z pozice sledovaného zákazníka.|1|"+cue);
optmenu.insert_last ("play_sr_prompt|Zvuková výzva k pokračování|Pokud hra mluví prostřednictvím odečítače, není na některých místech možné pokračovat k dalšímu kroku bez potvrzení enterem. V nabídce nastavení rozhraní si můžeš ještě zvlášť nastavit slovní upozornění místo zvukového.|1|"+play_sr_prompt+"|0|"+forced_output);
optmenu.insert_last ("play_utterance|Zvuk nové promluvy v historii řeči|Když je toto nastavení zapnuté, ozve se zvuk vždycky, když program vysloví některou hlášku, která se dá zopakovat v historii řeči. Dostaneš tak upozornění, že hra řekla něco, co by bylo dobré nepřeslechnout. To se může hodit v náročnějších, rychlejších a hlučnějších hrách. Příslušný zvuk najdeš v nabídce Seznámení se zvuky.|1|"+play_say);
optmenu.insert_last ("steps_overall|Všechny kroky celkově| |2|"+play_steps);
optmenu.insert_last ("player_steps|Kroky hráče|");
if (!play_steps) optmenu[optmenu.length()-1]+="Nelze zapnout, když je zakázané přehrávání všech kroků.";
else optmenu[optmenu.length()-1]+=" ";
optmenu[optmenu.length()-1]+="|2|"+player_steps+"|0|"+!play_steps;
optmenu.insert_last ("dangerous_steps|Kroky nebezpečných zákazníků|Nebezpeční zákazníci jsou zákazníci, kteří se naštvali na někoho jiného, a ožralové, kteří dělají bordel.");
if (!play_steps) optmenu[optmenu.length()-1]+=" Toto nastavení nelze zapnout, když je zakázané přehrávání všech kroků.";
optmenu[optmenu.length()-1]+="|2|"+dangerous_steps+"|0|"+!play_steps;
optmenu.insert_last ("helper_steps|Kroky pomocníků|");
if (!play_steps) optmenu[optmenu.length()-1]+="Nelze zapnout, když je zakázané přehrávání všech kroků.";
else optmenu[optmenu.length()-1]+=" ";
optmenu[optmenu.length()-1]+="|2|"+helper_steps+"|0|"+!play_steps;
optmenu.insert_last ("leaving_steps|Kroky zákazníků, kteří odcházejí|");
if (!play_steps) optmenu[optmenu.length()-1]+="Nelze zapnout, když je zakázané přehrávání všech kroků.";
else optmenu[optmenu.length()-1]+=" ";
optmenu[optmenu.length()-1]+="|2|"+leaving_steps+"|0|"+!play_steps;
optmenu.insert_last ("queue_steps|Kroky zákazníků, kteří čekají ve frontě|");
if (!play_steps) optmenu[optmenu.length()-1]+="Nelze zapnout, když je zakázané přehrávání všech kroků.";
else optmenu[optmenu.length()-1]+=" ";
optmenu[optmenu.length()-1]+="|2|"+queue_steps+"|0|"+!play_steps;
optmenu.insert_last ("order_steps|Kroky zákazníků, kteří si ještě neobjednali|");
if (!play_steps) optmenu[optmenu.length()-1]+="Nelze zapnout, když je zakázané přehrávání všech kroků.";
else optmenu[optmenu.length()-1]+=" ";
optmenu[optmenu.length()-1]+="|2|"+order_steps+"|0|"+!play_steps;
optmenu.insert_last ("other_steps|Kroky všech ostatních zákazníků|Například těch, kteří právě jdou k jukeboxu, odnášejí půllitr nebo jdou na záchod a tak dále.");
if (!play_steps) optmenu[optmenu.length()-1]+=" Toto nastavení nelze zapnout, když je zakázané přehrávání všech kroků.";
else optmenu[optmenu.length()-1]+=" ";
optmenu[optmenu.length()-1]+="|2|"+other_steps+"|0|"+!play_steps;
optmenu.insert_last ("mono_audio|Monofonní zvuk| |3|"+mono_audio);
optmenu.insert_last ("stereo_invert|Prohodit stereo|Umožňuje Obrátit směr, odkud se ozývají jednotlivé zvuky, pokud máš reproduktory nebo sluchátka obráceně.|3|"+stereo_invert+"|0|"+mono_audio);
optmenu.insert_last ("stereo_left|Levý okraj stereopole|Umožňuje omezit, jak moc daleko vlevo se smí přehrávat zvuky. Pokud toto nastavení změníš, místo, odkud zvuk pocitově slyšíš, nemusí odpovídat počtu kroků, které musíš udělat, než k tomuto zvuku dojdeš.|3|2|1|"+mono_audio);
optmenu.insert_last ("stereo_center|Střed stereopole|Umožňuje nastavit výchozí bod pro přehrávání zvuků, tedy odkud se budou ozývat zvuky, které mají znít přímo před tebou. Musí být mezi krajními hodnotami.|3|2|1|"+mono_audio);
optmenu.insert_last ("stereo_right|Pravý okraj stereopole|Umožňuje omezit, jak moc daleko vpravo se smí přehrávat zvuky. Pokud toto nastavení změníš, místo, odkud zvuk pocitově slyšíš, nemusí odpovídat počtu kroků, které musíš udělat, než k tomuto zvuku dojdeš.|3|2|1|"+mono_audio);
optmenu.insert_last ("stereo_test|Otestovat přehrávání ve stereu|"+stereo_test_description+"|3|2|0|"+mono_audio);
optmenu.insert_last ("restore_stereo|Obnovit výchozí nastavení stereopole| |3");
optmenu.insert_last ("master_volume|Celková hlasitost: "+get_volume (loudness)+"|Veškeré dílčí hlasitosti fungují relativně k této hlasitosti.|4|2|1");
optmenu.insert_last ("menu_music_vol|Hlasitost hudby v nabídkách: "+get_volume (menuloop_vol)+"| |4|2|1|"+!play_menu_music);
optmenu.insert_last ("game_music_volume|Hlasitost jukeboxu: "+get_volume (gamemusic_vol)+"| |4|2|1|"+!play_game_music);
optmenu.insert_last ("menu_vol|Hlasitost zvuků při pohybu v nabídkách: "+get_volume (menu_sounds_vol)+"| |4|2|1|"+!play_menu_sounds);
optmenu.insert_last ("mugloop_volume|Hlasitost zvuku Půllitrů: "+get_volume (mugloop_vol)+"| |4|2|1|"+!play_mugloop);
optmenu.insert_last ("barrelloop_volume|Hlasitost zvuku sudů: "+get_volume (barrelloop_vol)+"| |4|2|1|"+!play_barrelloop);
optmenu.insert_last ("near_customer_volume|Hlasitost zvuku prvního zákazníka ve frontě nebo sledovaného zákazníka: "+get_volume (nearby_vol)+"| |4|2|1|"+!cue);
optmenu.insert_last ("vocals_volume|Hlasitost hlášek zákazníků: "+get_volume (vocals_vol)+"| |4|2|1|"+!use_vocals);
optmenu.insert_last ("player_vol|Hlasitost kroků hráče: "+get_volume (player_steps_vol)+"| |5|2|1|"+(!play_steps or !player_steps));
optmenu.insert_last ("dangerous_vol|Hlasitost kroků nebezpečných zákazníků: "+get_volume (dangerous_steps_vol)+"| |5|2|1|"+(!play_steps or !dangerous_steps));
optmenu.insert_last ("helper_vol|Hlasitost kroků pomocníků: "+get_volume (helper_steps_vol)+"| |5|2|1|"+(!play_steps or !helper_steps));
optmenu.insert_last ("leaving_vol|Hlasitost kroků zákazníků, kteří odcházejí: "+get_volume (leaving_steps_vol)+"| |5|2|1|"+(!play_steps or !leaving_steps));
optmenu.insert_last ("queue_vol|Hlasitost kroků zákazníků, kteří čekají ve frontě: "+get_volume (queue_steps_vol)+"| |5|2|1|"+(!play_steps or !queue_steps));
optmenu.insert_last ("order_vol|Hlasitost kroků zákazníků, kteří si ještě neobjednali: "+get_volume (order_steps_vol)+"| |5|2|1|"+(!play_steps or !order_steps));
optmenu.insert_last ("other_vol|Hlasitost kroků všech ostatních zákazníků: "+get_volume (other_steps_vol)+"| |5|2|1|"+(!play_steps or !other_steps));
optmenu.insert_last ("restore_volumes|Obnovit výchozí nastavení všech hlasitostí| |5");
optmenu.insert_last ("learn_sounds|Seznámení se zvuky|Obsahuje klíčové zvuky, které potřebuješ znát. Během hry můžeš nabídku seznámení se zvuky kdykoli otevřít klávesou ef 3 nebo z kontextového menu.|6|2|1");
if (!onboarding) optmenu.insert_last ("restore_audio_defaults|Obnovit všechna výchozí nastavení zvuku| |6");
string[] secs={"Které zvuky přehrávat", "Které zvuky kroků přehrávat", "Nastavení přehrávání ve stereu", "Nastavení hlasitostí", "Nastavení hlasitostí kroků", ""};
if (tempres == -1) tempres=1;
tempres=make_menu (optmenu, tempres, tempmenu, first, secs, !first);
first=false;
item=tempmenu.get_item_name (tempres);
if (instr (item, "play_game_music"))
{
play_game_music=!play_game_music;
if (!play_game_music)
{
stop_jukebox();
clear_jukebox();
purge_music();
}
}
else if (instr (item, "play_menu_music_in_game")) play_menu_music_in_game=!play_menu_music_in_game;
else if (instr (item, "intro")) play_intro=!play_intro;
else if (instr (item, "outro")) play_outro=!play_outro;
else if (instr (item, "menu_sounds"))
{
play_menu_sounds=!play_menu_sounds;
if (play_menu_sounds) play_enter();
}
else if (instr (item, "submenu")) play_submenu_sound=!play_submenu_sound;
else if (instr (item, "logo")) play_logo=!play_logo;
else if (instr (item, "single_loop"))
{
play_all_items=!play_all_items;
if (is_game) changed_item_loops=true;
}
else if (instr (item, "play_menu_music")) switch_menu_music();
else if (instr (item, "play_mug"))
{
play_mugloop=!play_mugloop;
if (is_game) changed_item_loops=true;
}
else if (instr (item, "play_barrel"))
{
play_barrelloop=!play_barrelloop;
if (is_game) changed_item_loops=true;
}
else if (instr (item, "beep")) cue=!cue;
else if (instr (item, "sr_prompt")) play_sr_prompt=!play_sr_prompt;
else if (instr (item, "mono"))
{
mono_audio=!mono_audio;
if (is_game) update_stereo();
}
else if (instr (item, "invert"))
{
stereo_invert=!stereo_invert;
if (is_game) update_stereo();
}
else if (instr (item, "master_v"))
{
loudness=set_volume (loudness);
set_sound_master_volume (loudness);
first=true;
}
else if (instr (item, "game_music_v"))
{
gamemusic_vol=set_volume (gamemusic_vol);
if (is_game) update_volumes();
first=true;
}
else if (instr (item, "near_customer_v"))
{
nearby_vol=set_volume (nearby_vol);
if (is_game) update_volumes();
first=true;
}
else if (instr (item, "menu_music_v"))
{
menuloop_vol=set_volume (menuloop_vol);
first=true;
}
else if (instr (item, "mugloop_v"))
{
mugloop_vol=set_volume (mugloop_vol);
if (is_game) update_volumes();
first=true;
}
else if (instr (item, "barrelloop_v"))
{
barrelloop_vol=set_volume (barrelloop_vol);
if (is_game) update_volumes();
first=true;
}
else if (instr (item, "vocals_v"))
{
vocals_vol=set_volume (vocals_vol);
first=true;
}
else if (instr (item, "left"))
{
stereo_left=set_stereo (stereo_left, 0, "levý okraj sterea");
if (is_game) update_stereo();
first=true;
}
else if (instr (item, "center"))
{
stereo_center=set_stereo (stereo_center, 1, "střed sterea");
if (is_game) update_stereo();
first=true;
}
else if (instr (item, "right"))
{
stereo_right=set_stereo (stereo_right, 2, "pravý okraj sterea");
if (is_game) update_stereo();
first=true;
}
else if (instr (item, "learn"))
{
learn();
first=true;
}
else if (instr (item, "test"))
{
speakers();
first=true;
}
else if (instr (item, "steps_overall")) play_steps=!play_steps;
else if (instr (item, "player_steps")) player_steps=!player_steps;
else if (instr (item, "dangerous_steps")) dangerous_steps=!dangerous_steps;
else if (instr (item, "helper_steps")) helper_steps=!helper_steps;
else if (instr (item, "leaving_steps")) leaving_steps=!leaving_steps;
else if (instr (item, "queue_steps")) queue_steps=!queue_steps;
else if (instr (item, "order_steps")) order_steps=!order_steps;
else if (instr (item, "other_steps")) other_steps=!other_steps;
else if (instr (item, "player_vol"))
{
player_steps_vol=set_volume (player_steps_vol);
first=true;
}
else if (instr (item, "dangerous_vol"))
{
dangerous_steps_vol=set_volume (dangerous_steps_vol);
first=true;
}
else if (instr (item, "helper_vol"))
{
helper_steps_vol=set_volume (helper_steps_vol);
first=true;
}
else if (instr (item, "leaving_vol"))
{
leaving_steps_vol=set_volume (leaving_steps_vol);
first=true;
}
else if (instr (item, "queue_vol"))
{
queue_steps_vol=set_volume (queue_steps_vol);
first=true;
}
else if (instr (item, "order_vol"))
{
order_steps_vol=set_volume (order_steps_vol);
first=true;
}
else if (instr (item, "other_vol"))
{
other_steps_vol=set_volume (other_steps_vol);
first=true;
}
else if (instr (item, "menu_vol"))
{
custbeep.volume=menu_sounds_vol;
doingsound.volume=menu_sounds_vol;
first=true;
}
else if (instr (item, "utterance")) play_say=!play_say;
else if (instr (item, "volumes"))
{
restore_volumes (false);
first=true;
}
else if (instr (item, "restore_stereo"))
{
restore_stereo (false);
first=true;
}
else if (instr (item, "audio_defaults"))
{
restore_audio_defaults (false);
return;
}
else if (instr (item, "continue")) break;
}
}

void restore_audio_defaults (bool silent)
{
play_intro=true;
play_outro=true;
play_menu_music=true;
play_game_music=true;
play_menu_music_in_game=false;
play_logo=true;
play_menu_sounds=true;
play_submenu_sound=true;
play_mugloop=true;
play_barrelloop=true;
play_all_items=true;
play_sr_prompt=true;
play_steps=true;
player_steps=true;
helper_steps=true;
dangerous_steps=true;
leaving_steps=true;
order_steps=true;
queue_steps=true;
other_steps=true;
play_say=true;
if (is_game) changed_item_loops=true;
restore_stereo (true);
restore_volumes (true);
if (!silent) say ("Výchozí nastavení zvuku obnovena.", true, false, true);
}

void restore_volumes (bool silent)
{
loudness=defvol;
set_sound_master_volume (loudness);
menuloop_vol=0;
mugloop_vol=0;
barrelloop_vol=0;
gamemusic_vol=-4;
nearby_vol=0;
vocals_vol=0;
player_steps_vol=0;
dangerous_steps_vol=0;
helper_steps_vol=0;
leaving_steps_vol=0;
order_steps_vol=0;
queue_steps_vol=0;
other_steps_vol=0;
menu_sounds_vol=0;
if (is_game) update_volumes();
if (!silent) say ("Výchozí nastavení hlasitostí obnoveno.", true, false, true);
}

void restore_stereo (bool silent)
{
mono_audio=false;
stereo_invert=false;
stereo_left=left_edge;
stereo_center=0;
stereo_right=right_edge;
if (is_game) update_stereo();
if (!silent) say ("Výchozí nastavení sterea obnovena.", true, false, true);
}

void restore_all_defaults()
{
restore_ui_defaults (true);
restore_game_defaults (true);
restore_audio_defaults (true);
string results="Všechna výchozí nastavení obnovena.";
say (results, true, false, true);
}

string get_volume (double vol)
{
string ret=volmenu_items[volmenu_values.find(vol)+1];
return ret.substr (ret.find("|")+1);
}

void text_entry_callback()
{
string help_msg="Text zadávej pomocí standardních kláves obvyklých v jiných programech.\r\nFunguje pohyb i mazání po slovech, označování textu, kopírování, vyjímání i vkládání.\r\nŠipka nahoru nebo dolů: Přečtení stávajícího textu, se šiftem text vyhláskuje. Editační pole je jednořádkové.\r\nEnter: Potvrzení zadaného textu.\r\nEskejp: Návrat do předchozí nabídky.\r\nAlt plus ef čtyři: Ukončení programu.\r\nEf jedna: Zobrazení těchto zkratek v seznamu pro pohodlnější čtení.";
if (singlekey (KEY_F1))
{
read_menu (help_msg);
help_read=true;
ui_help_timer.restart();
ui_help_timer.pause();
}
if (speak_ui_help)
{
if (input.frames.elapsed>=ui_help_delay and input.said_max and down_keys()==0 and !help_read)
{
say (help_msg, false, false);
help_read=true;
ui_help_timer.restart();
ui_help_timer.pause();
}
if (ui_help_timer.elapsed<ui_help_delay and down_keys()>0) ui_help_timer.restart();
}
}

void clear_profile()
{
if (ask ("Chceš opravdu smazat celý svůj profil a veškerá nastavení? Budeš pak muset začít hrát znovu úplně od začátku jako po prvním spuštění. Tento krok nejde odvolat!")==1)
{
directory_delete (folder.substr (0, folder.length()-1));
run (SCRIPT_EXECUTABLE, "", false, false);
exit();
}
}

void read_menu (string[] arr)
{
string joined="";
uint l=arr.length();
for (uint i=0; i<l; i++) joined+=arr[i]+"\r\n";
read_menu (joined);
}

void set_date (bool is_birthday)
{
int8 tempres=1;
while(true)
{
int8 dayres, monres;
if (is_birthday)
{
dayres=birth_day;
monres=birth_month;
}
else
{
dayres=name_day;
monres=name_month;
}
if (dayres==0) dayres=1;
if (monres==0) monres=1;
dynamic_menu tempmenu;
string[] datemenu={"Nastav datum", "day|Den|"+days[dayres-1], "month|Měsíc|"+months[monres-1]};
tempres=make_menu (datemenu, tempres, @tempmenu);
if (tempres==1)
{
if (is_birthday) birth_day=set_day (dayres);
else name_day=set_day (dayres);
}
else if (tempres==2)
{
if (is_birthday) birth_month=set_month (monres);
else name_month=set_month (monres);
break;
}
else break;
}
}

uint8 set_day (uint8 day)
{
dynamic_menu tempmenu;
string[] day_names=days;
day_names.insert_at (0, "Nastav den");
uint8 tempres=make_menu (day_names, day, @tempmenu);
if (tempres==0) return 1;
return tempres;
}

uint8 set_month (uint8 month)
{
dynamic_menu tempmenu;
string[] month_names=months;
month_names.insert_at (0, "Nastav měsíc");
uint8 tempres=make_menu (month_names, month, @tempmenu);
if (tempres==0) return 1;
return tempres;
}

bool check_profile()
{
if (name_day==0 or name_month==0) return false;
if (birth_day==0 or birth_month==0) return false;
return true;
}

void reset_ui_help()
{
help_read=false;
ui_help_timer.restart();
}


