void reset ()
{
reset_debugging();
if (!preloads.is_empty())
{
wait_keys();
if (!play_logo) wait_menu();
if (output == 0) wait_speech();
}
else
{
say ("Načítají se zvuky.", true, false);
wait_menu();
}
@top_menu=null;
switch (difficulty)
{
case 1:
bottom=-10;
max=12;
maxfled=4;
maxstunned=2;
limit=15*60*fps;
trip_time=round ((20.0/60.0)*fps, 0);
spawn_delay=50*fps;
all_speed=round ((30.0/60.0)*fps, 0);
aggression=4;
ceiling=4;
trance=round ((130.0/60.0)*fps, 0);
mug_count=50;
barrel_count=10;
beer_count=30;
hit_interval=round ((120.0/60.0)*fps, 0);
max_liquid_mess=14;
puke_count=3;
max_drink_time=round ((50.0/60.0)*fps, 0);
min_price=20;
pay_most_jukebox_once=200;
serve_interval=180*fps;
break;
case 2:
bottom=-15;
max=15;
maxfled=6;
maxstunned=5;
limit=20*60*fps;
trip_time=round ((40.0/60.0)*fps, 0);
spawn_delay=45*fps;
all_speed=round ((25.0/60.0)*fps, 0);
aggression=3;
ceiling=3;
trance=round ((110.0/60.0)*fps, 0);
mug_count=40;
barrel_count=15;
beer_count=25;
hit_interval=round ((90.0/60.0)*fps, 0);
max_liquid_mess=12;
puke_count=6;
max_drink_time=round ((45.0/60.0)*fps, 0);
min_price=30;
pay_most_jukebox_once=300;
serve_interval=150*fps;
break;
case 3:
bottom=-20;
max=20;
maxfled=9;
maxstunned=10;
limit=25*60*fps;
trip_time=round ((60.0/60.0)*fps, 0);
spawn_delay=40*fps;
all_speed=round ((20.0/60.0)*fps, 0);
aggression=2;
ceiling=2;
trance=round ((90.0/60.0)*fps, 0);
mug_count=30;
barrel_count=20;
beer_count=20;
hit_interval=round ((60.0/60.0)*fps, 0);
max_liquid_mess=10;
puke_count=8;
max_drink_time=round ((40.0/60.0)*fps, 0);
min_price=40;
pay_most_jukebox_once=400;
serve_interval=120*fps;
break;
case 4:
bottom=-25;
max=30;
maxfled=13;
maxstunned=15;
limit=30*60*fps;
trip_time=round ((80.0/60.0)*fps, 0);
spawn_delay=35*fps;
all_speed=round ((15.0/60.0)*fps, 0);
aggression=1;
ceiling=1;
trance=round ((70.0/60.0)*fps, 0);
mug_count=25;
barrel_count=25;
beer_count=15;
hit_interval=round ((30.0/60.0)*fps, 0);
max_liquid_mess=8;
puke_count=12;
max_drink_time=round ((35.0/60.0)*fps, 0);
min_price=50;
pay_most_jukebox_once=500;
serve_interval=90*fps;
break;
case 5:
bottom=-30;
max=40;
maxfled=15;
maxstunned=20;
limit=35*60*fps;
trip_time=round ((100.0/60.0)*fps, 0);
spawn_delay=30*fps;
aggression=0;
ceiling=0;
all_speed=round ((10.0/60.0)*fps, 0);
trance=round ((50.0/60.0)*fps, 0);
mug_count=20;
barrel_count=30;
beer_count=10;
hit_interval=round ((20.0/60.0)*fps, 0);
max_liquid_mess=6;
puke_count=20;
max_drink_time=round ((30.0/60.0)*fps, 0);
min_price=60;
pay_most_jukebox_once=600;
serve_interval=75*fps;
break;
}
min_drink_time=round (((25.0/60.0)*fps)/2, 0);
max_drink_time=round (max_drink_time/2, 0);
max_price=min_price+20;
time_since_served=0;
if (endless) limit=0;
@mission=null;
current_objectives=objectives;
total_stuns=0;
faucet_distance=5+(5*difficulty);
bottom*=2;
sleep_time=difficulty*60*fps;
longest=0;
most=0;
served=0;
served_correct=0;
undermeasures=0;
dirty_drinks=0;
single_drinks=0;
mixed_drinks=0;
most_beers=0;
most_patient=0;
washed=0;
broken=0;
fallen=0;
broken_nonempty=0;
fallen_nonempty=0;
fled=0;
fled_total=0;
hurt=0;
thrown=0;
stunned=0;
wash_time=(60-(10*difficulty))*fps;
total_puked=0;
@tracking=null;
tracker=0;
track_x=-127;
track_y=-127;
track_distance=-127;
track_state=-1;
helpers=0;
pourers=0;
cleaners=0;
givers=0;
throwers=0;
barrelers=0;
emptiers=0;
calmers=0;
total_trips=0;
total_falls=0;
mistakes=0;
roamers=0;
chasers=0;
slept=0;
most_queue=0;
most_hits=0;
spawned=0;
dried=0;
filter_available_tracks();
playlist.resize(0);
playing=0;
repeat_playlist=false;
between_jingles=0;
last_track="";
reset_objects();
if (is_tutorial)
{
endless=true;
limit=0;
faucet.x=sink.x -(20 *step_size);
player.x=faucet.x;
stairs=faucet.x-(20*step_size);
ceiling=1;
uint l=tutorials.length();
for (uint i=0; i<l; i++) tutorials[i].said=false;
@mission=current_objectives[0];
max_drink_time=min_drink_time;
}
flusher=0;
flushed=0;
toiletslot=-1;
nearby=-1;
steps=0;
money=0;
replaced=0;
gratuity=0;
most_gratuity_once=0;
most_gratuity_total=0;
most_paid=0;
paused=false;
said_helpers=false;
if (beers.is_empty() and !choose_beers()) return;
prices.resize (beers.length());
uint8 p=beers.length(), drink_price;
for (uint8 x=0; x<p; x++)
{
do
drink_price=random (min_price, max_price);
while (prices.find (drink_price) > -1);
prices[x]=drink_price;
}
faucet.reset();
do
stairs=random (left_edge+step_size, right_edge-step_size);
while (stairs==faucet.x);
do
radio=random (left_edge+step_size, right_edge-step_size);
while (radio==faucet.x or radio==stairs);
do
toilet=random (left_edge+step_size, right_edge-step_size);
while (toilet==faucet.x or toilet==stairs or toilet==radio);
if (reset_history) history.resize (0);
history_index=0;
history_old_index=0;
earned_jukebox=0;
earned_jukebox_most_customer=0;
played_jukebox=0;
played_jukebox_player=0;
played_jukebox_customers=0;
use_jukebox=random (1, difficulty);
if (freeplay)
{
limit=0;
enable_roaming=free_roam;
enable_idle=free_sleep;
}
if (preloads.is_empty()) preload_audio();
if (play_logo)
{
int8 logo=play_stat ("logo");
while (pool.sound_is_playing (logo))
{
wait (5);
closekey();
if (singlekey (KEY_SPACE) or singlekey (KEY_RETURN) or singlekey (KEY_NUMPAD_ENTER) or singlekey (KEY_ESCAPE)) fadeout();
else if (menuloop.playing) menuloop.volume-=0.5*(60.0/fps);
else if (menustart.playing) menustart.volume-=0.5*(60.0/fps);
}
if (menuloop.playing or menustart.playing) stop_menu_music();
}
else
{
wait_keys();
if (output==0) wait_speech();
if (menuloop.playing or menustart.playing) fadeout();
}
if (menuloop.playing or menustart.playing) stop_menu_music();
menuloop.volume=menuloop_vol;
menustart.volume=menuloop_vol;
player.x=faucet.x;
player.speed=percent (all_speed, 55);
player.default_speed=player.speed;
player.transition=((fps/10)*6)-((fps/10)*difficulty);
mug_path=get_distance(faucet.x,sink.x)*player.speed*2;
timewarn=false;
for (uint8 x=0; x<max; x++)
{
character new;
new.reset (false);
custpool.insert_last (new);
}
for (uint8 x=0; x<mug_count; x++)
{
mug new;
mugs.insert_last (new);
}
for (uint8 x=0; x<barrel_count; x++)
{
barrel new;
barrels.insert_last (new);
}
pool.destroy_all();
things.destroy_all();
custbeep.pan=0;
custbeep.volume=0;
set_sound_master_volume (minvol);
faucet.slot=faucet.play ("faucet", true);
spawner=spawn_delay-(5*fps);
clear_player();
single_most_gender=1;
single_drank_gender=1;
single_longest_gender=1;
is_game=true;
elapsed=0;
game();
fadein();
ambience=pool.play_stationary_extended ("ambience"+ext, true, 0, stereo_center, -20, 100);
elapsed=0;
clear_player();
time_since_served=0;
}

void pause (bool speak=true)
{
garbage_collect();
if (paused) return;
silence();
pool.pause_all();
things.pause_all();
paused=true;
if (speak) say ("Pauza.", true, false);
}

void resume()
{
if (!paused) return;
garbage_collect();
if (@tracking == null and tracker == 0) silence();
if (changed_item_loops) clear_item_loops();
pool.resume_all();
uint l=things.items.length();
for (uint i=0; i<l; i++)
if (@things.items[i].handle != null and !instr (things.items[i].filename, "pour")) things.resume_sound (i);
paused=false;
oldpaused=false;
}

void lose (uint8 killed=0)
{
is_game=false;
uint8 c=customers.length();
string cause;
if (limit > 0 and elapsed >= limit)
{
cause="Výborně! Zvládl";
if (gender==2) cause+="a";
string survived=get_time (false, elapsed);
if (survived.length()>0) survived=survived.substr (0, survived.length()-1);
cause+=" jsi to vydržet celých "+survived+"! Gratuluju!\r\n";
if (!is_tutorial)
{
say ("Zavíráme. Na shle.", false, true);
play_stat ("timesup");
}
if (hardcore) cause+="A navíc s dodatečnými omezeními, protože ani normální, už tak dost vysoká obtížnost ti evidentně nebyla dost dobrá. To už je opravdu výkon. Smekám!\r\n";
}
else
{
cause="Tak končí tvoje nedlouhá a neslavná kariéra barman";
if (gender==1 or gender==0) cause+="a";
else cause+="ky";
cause+=". Snad příště.\r\n";
if (player.health <= 0)
{
if (((player.fell_from > bottom and player.y<0) or player.state==falldown) and !player.punched)
{
cause+="No jo, nemáš tolik padat ze schodů.\r\n";
set_stat (prefix_mode()+"died_falls", 1);
}
else if ((player.state==tripped or player.state==falldown) and !player.punched)
{
cause+="No jo, nemáš tolik zakopávat.\r\n";
set_stat (prefix_mode()+"died_trips", 1);
}
else if (player.punched)
{
cause+="Anebo radši ne. Třeba by na tebe zase byli zákazníci tak naštvaní, že by tě umlátili až k smrti, jako právě teď.\r\n";
set_stat (prefix_mode()+"died_punched", 1);
}
}
else if (player.state==closing)
{
cause+="Tys normálně zbaběle utek";
if (gender==2) cause+="la";
cause+="! Fuuuj!\r\n";
set_stat (prefix_mode()+"died_player_fled", 1);
}
else if (killed == 1)
{
cause+="Náš zákazník, náš pán, to ti asi nic neříká. Když na ně budeš takhle kašlat, dlouho ti to procházet nebude.\r\n";
set_stat (prefix_mode()+"died_player_slouch", 1);
}
else if (killed == 2)
{
cause+="Když jsi dopustil";
if (gender==2) cause+="a";
cause+=", aby ti tu normálně před očima umřel člověk, tak se nediv.\r\n";
set_stat (prefix_mode()+"died_customer", 1);
}
else if (broken == mug_count)
{
cause+="Rozbily se ti všechny půllitry.\r\n";
set_stat (prefix_mode()+"died_mugs", 1);
}
if (fled > 0 and !allow_fled)
{
cause+="V této hardcore hře nesměl nikdo nespokojený odejít.\r\n";
set_stat (prefix_mode()+"died_fled", 1);
}
if (stunned > 0 and !allow_stunned)
{
cause+="V této hardcore hře jsi nesměl";
if (gender==2) cause+="a";
cause+=" nikoho omráčit.\r\n";
set_stat (prefix_mode()+"died_stunned", 1);
}
if (broken > 0 and !allow_broken)
{
cause+="V této hardcore hře se nesměl rozbít ani jeden půllitr.\r\n";
set_stat (prefix_mode()+"died_mug", 1);
}
if (fallen > 0 and !allow_fallen)
{
cause+="V této hardcore hře se nesměl rozbít ani jeden sud.\r\n";
set_stat (prefix_mode()+"died_barrel", 1);
}
if (total_trips > 0 and !allow_trips)
{
cause+="V této hardcore hře jsi nesměl";
if (gender==2) cause+="a";
cause+=" ani jednou zakopnout.\r\n";
set_stat (prefix_mode()+"died_trip", 1);
}
if (total_falls > 0 and !allow_falls)
{
cause+="V této hardcore hře jsi nesměl";
if (gender==2) cause+="a";
cause+=" ani jednou spadnout ze schodů.\r\n";
set_stat (prefix_mode()+"died_fall", 1);
}
if (count_mess (2) +count_mess (3) >= max_liquid_mess and !allow_messy)
{
cause+="V této hardcore hře ti nesměli všichni zákazníci utéct kvůli nepořádku.\r\n";
set_stat (prefix_mode()+"died_messy", 1);
}
if (killed == 3)
{
cause+="V této hardcore hře jsi nesměl";
if (gender==2) cause+="a";
cause+=" donést ani jedno špatné pití nebo podmírák.\r\n";
set_stat (prefix_mode()+"died_mistake", 1);
}
if (killed == 4)
{
cause+="V této hardcore hře tě nikdo nesměl ani jednou praštit.\r\n";
set_stat (prefix_mode()+"died_punch", 1);
}
}
make_stats (false);
if (hardcore)
{
cause+="Měl";
if (gender==2) cause+="a";
cause+=" jsi zapnutá tato hardcore omezení:\r\n";
if (!allow_helpers) cause+="Zakázané všechny pomocníky\r\n";
else
{
cause+="Zakázané pomocníky:\r\n";
if (!allow_servers) cause+="Na točení\r\n";
if (!allow_givers) cause+="Na roznášení pití\r\n";
if (!allow_cleaners) cause+="Na odnášení špinavých půllitrů\r\n";
if (!allow_emptiers) cause+="Na odnášení prázdných sudů\r\n";
if (!allow_barrelers) cause+="Na nošení nových sudů\r\n";
if (!allow_throwers) cause+="Na vyhazování ožralů\r\n";
if (!allow_calmers) cause+="Na pacifikování agresivních zákazníků\r\n";
}
if (!allow_trips)
{
cause+="Nesměl";
if (gender==2) cause+="a";
cause+=" jsi zakopnout\r\n";
}
if (!allow_falls)
{
cause+="Nesměl";
if (gender==2) cause+="a";
cause+=" jsi spadnout ze schodů\r\n";
}
if (!allow_stunned)
{
cause+="Nesměl";
if (gender==2) cause+="a";
cause+=" jsi nikoho omráčit\r\n";
}
if (!allow_playerhits) cause+="Nikdo tě nesměl praštit\r\n";
if (!allow_fled) cause+="Nikdo nesměl odejít\r\n";
if (!allow_mistakes)
{
cause+="Nesměl";
if (gender==2) cause+="a";
cause+=" jsi nikomu dát špatné pití\r\n";
}
if (!allow_broken) cause+="Nesměl se rozbít ani jeden půllitr\r\n";
if (!allow_fallen) cause+="Nesměl se rozbít ani jeden sud\r\n";
if (!allow_messy) cause+="Nesměli ti utéct všichni zákazníci kvůli nepořádku\r\n";
}
if (endless or freeplay or elapsed < limit)
{
cause+=" Vydržel";
if (gender==2) cause+="a";
cause+=" jsi celkem "+get_time (false, elapsed)+"\r\n";
if (!endless and !freeplay)
{
cause+=" Do konce limitu "+get_time();
if (instr (cause, "hodina") or instr (cause, "minuta") or instr (cause, "vteřina")) cause=cause.replace ("Zbývá", "zbývala ještě", true);
else if (instr (cause, "Zbývají")) cause=cause.replace ("Zbývají", "zbývaly ještě", true);
else cause=cause.replace ("Zbývá", "zbývalo ještě", true);
cause+="\r\n";
}
}
if (longest > 0) cause+=" Zákazník, který tu byl nejdýl, tu strávil "+get_time (false, longest)+"\r\n";
if (customers.length() > 0)
{
cause+=" Právě teď ";
if (c == 1) cause+="tu byl jenom jeden zákazník.";
else if (c < 5) cause+="tu byli jenom "+c+" zákazníci.";
else cause+="tu bylo "+c+" zákazníků.";
cause+="\r\n";
if (!queue.is_empty())
{
uint8 q=queue.length();
if (q == 1) cause+=" Jeden čekal ";
else if (q < 5) cause+=q+" čekali ";
else cause+=q+" čekalo ";
cause+="ve frontě.\r\n";
}
else cause+=" Nikdo nečekal ve frontě.\r\n";
}
else if (most > 0)
{
cause+=" Právě teď jsi tu nikoho neměl";
if (gender==2) cause+="a";
cause+=".\r\n";
}
if (most > 0)
{
if (fled_total > 0)
{
if (fled_total == 1) cause+=" Jeden zákazník odešel.";
else if (fled_total < 5) cause+=" "+fled_total+" zákazníci odešli.";
else cause+=" "+fled_total+" zákazníků odešlo.";
cause+="\r\n";
uint8 happy=fled_total-fled;
if (happy > 0)
{
if (happy==fled_total)
{
if (happy==1) cause+="Byl spokojený.";
else cause+="Byli spokojení.";
cause+="\r\n";
}
else
{
if (happy == 1) cause+="Jeden z nich byl spokojený.";
else if (happy < 5) cause+=happy+" z nich byli spokojení.";
else cause+=happy+" z nich bylo spokojených.";
cause+="\r\n";
}
}
if (hurt > 0)
{
if (hurt == 1) cause+=" Jeden z nich byl už příliš zraněný.";
else if (hurt < 5) cause+=" "+hurt+" z nich byli už příliš zranění.";
else cause+=" "+hurt+" z nich bylo už příliš zraněných.";
cause+="\r\n";
}
}
else cause+=" Nikdo neodešel.\r\n";
if (allow_throwers)
{
if (thrown > 0)
{
cause+=" Vyhazovači vyvedli ";
if (thrown == 1) cause+="jednoho ožralu.";
else if (thrown < 5) cause+=thrown+" ožraly.";
else cause+=thrown+" ožralů.";
cause+="\r\n";
}
}
if (stunned > 0)
{
if (stunned == 1) cause+=" Jeden zákazník byl omráčený.";
else if (stunned < 5) cause+=" "+stunned+" zákazníci byli omráčení.";
else cause+=" "+stunned+" zákazníků bylo omráčených.";
cause+="\r\n";
}
if (most == 1)
{
cause+=" Promiň, já se ti nechci smát, ale když ty jsi měl";
if (gender==2) cause+="a";
cause+=" jenom jednoho chudáčka zákazníčka. To sem asi zabloudil omylem. Rozhodně je mi ho líto víc než tebe.";
}
else if (most < 5)
{
cause+=" Nejvíc jsi měl";
if (gender==2) cause+="a";
cause+=" jenom "+most+" zákazníky.";
}
else
{
cause+=" Nejvíc jsi měl";
if (gender==2) cause+="a";
cause+=" "+most+" zákazníků.";
}
cause+="\r\n";
