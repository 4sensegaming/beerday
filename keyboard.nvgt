bool keyhelp=false, foreground=true, old_foreground=true;

bool mod_shift()
{
return (keyboard_modifiers & KEYMOD_SHIFT) != 0;
}

bool mod_altgr()
{
return key_down (KEY_RALT);
}

bool mod_alt()
{
return (keyboard_modifiers & KEYMOD_ALT) != 0 or mod_altgr();
}

bool mod_ctrl()
{
return (keyboard_modifiers & KEYMOD_CTRL) != 0 or mod_altgr();
}

uint down_keys()
{
return keys_down().length();
}

void keyboard()
{
closekey();
bool ctrl=mod_ctrl(), shift=mod_shift(), alt=mod_alt();
if (singlekey (KEY_ESCAPE))
{
if (ask ("Ukončit tuto hru?", false, false) == 1)
{
is_game=false;
pool.destroy_all();
things.destroy_all();
if (autoplay or freeplay or is_tutorial) clear_earnings();
make_stats (true);
reset_objects();
autoplay=false;
endless=false;
elapsed=0;
paused=false;
menus();
}
}
else if (singlekey (KEY_P))
{
if (!paused) pause();
else resume();
}
else if (singlekey (KEY_E)) say_earned();
else if (singlekey (KEY_T)) say_game();
else if (lone (KEY_C) and !alt)
{
if (!ctrl and !shift) say_customers();
else if (!ctrl and shift) track_menu();
else if (ctrl and !shift) name_local_customer();
}
else if (lone (KEY_L) and !ctrl and !alt)
{
if (!shift) say_fled();
else say_thrown();
}
else if (singlekey (KEY_F)) say (say_pipe (false), true, false);
else if (singlekey (KEY_S)) say ("Schody jsou "+say_distance (stairs, 0, false), true, false);
else if (singlekey (KEY_D)) say (say_door (false), true, false);
else if (singlekey (KEY_I)) say (say_sink (false), true, false);
else if (singlekey (KEY_H)) say (player.say_health(), true, false);
else if (lone (KEY_M) and !alt)
{
if (shift and !ctrl) say_mug (true, true, player.hand);
else if (ctrl and !shift) say (count_mugs (player), true, false);
else if (!ctrl and !shift) say_mugs();
}
else if (lone (KEY_B))
{
if (!ctrl and !shift and !alt) say (say_barrel(), true, false);
else if (!ctrl and shift and !alt) say_broken_barrels();
else if (ctrl and !shift and !alt) say_replaced_barrels();
else if (!ctrl and !shift and alt) say_misplaced_barrels();
}
else if (singlekey (KEY_SPACE)) info();
else if (singlekey (KEY_G)) say_given();
else if (lone (KEY_U) and !alt)
{
if (!shift and !ctrl) say_dirty();
else if (shift and !ctrl) say_broken_mugs();
else if (ctrl and !shift) say_nonempty();
}
else if (lone (KEY_Q) and !ctrl and !alt)
{
if (!shift) say_queue();
else say_queue_count();
}
for (uint8 i=0; i<10; i++)
if (lone (rowkeys[i], 3) or lone (numkeys[i], 3))
{
if (queue.length() < numvals[i]+1)
{
if (queue.is_empty()) say ("Nikdo ve frontě.", true, false);
else say ("Tolik zákazníků ve frontě není.", true, false);
}
else
{
character@ h=queue[numvals[i]];
if (ctrl and !alt)
{
if (@tracking == @h) untrack();
else start_tracking (h);
}
else if (!ctrl and alt) say ("Chce "+h.get_drink(), true, false);
else if (!ctrl and !alt) say_customer (h, true, true);
else if (ctrl and alt) name_customer_manually (h);
}
break;
}
else if (singlekey (KEY_J)) say (say_jukebox (false), true, false);
else if (singlekey (KEY_APPLICATION) or singlekey (KEY_PRINTSCREEN) or (lone (KEY_F10) and shift and !ctrl and !alt)) con();
else if (singlekey (KEY_TAB)) player_position();
else if (singlekey (KEY_F1)) help();
else if (singlekey (KEY_F2)) options();
else if (singlekey (KEY_F3)) learn();
if (use_history) history_keys();
if (enable_debugging and singlekey (debugging_key)) debug_menu();
if (autoplay) return;
if (!paused)
{
uint held=down_keys();
if (key_pressed (KEY_LEFT) and held <= 2 and !shift and !alt)
{
if (!ctrl) player.walk (0);
else player.set_pipe (false);
}
else if (key_pressed (KEY_RIGHT) and held <= 2 and !shift and !alt)
{
if (!ctrl) player.walk (1);
else player.set_pipe (true);
}
else if (key_pressed (KEY_UP) and held <= 3 and !alt)
{
if (!ctrl and !shift) player.walk (2);
else if (ctrl and !shift) set_mug (player.holding+1);
else if (ctrl and shift) set_mug (player.carrying.length()-1);
}
else if (key_pressed (KEY_DOWN) and held <= 3 and !alt)
{
if (!ctrl and !shift) player.walk (3);
else if (ctrl and !shift) set_mug (player.holding-1);
else if (ctrl and shift) set_mug (0);
}
else if ((key_pressed (KEY_RETURN) or key_pressed (KEY_NUMPAD_ENTER)) and held <= 2 and !ctrl and !alt)
{
if (held == 1) action();
else if (shift)
{
if (@player.hand!=null) player.give_mug();
else if (player.x==radio and player.y==0)
{
if (@player.has_barrel!=null)
{
error ("Nemůžeš pustit jukebox, když neseš sud.");
return;
}
gallery (true);
}
}
}
}
}

void modifiers()
{
foreground=is_window_active();
if (!foreground and foreground!=old_foreground)
{
if (pause_on_blur)
{
if (output==0 and fallback_voice.speaking) silence();
if (is_custmenu) silence_custmenu();
if (!paused and is_game) pause();
if (menustart.playing) menustart.pause();
else if (menuloop.playing) stop_menu_music();
else if (won.playing) won.pause();
}
else
{
double cur=get_sound_master_volume();
cur=loudness-10;
if (cur<minvol) cur=minvol;
set_sound_master_volume (cur);
}
}
else if (foreground and foreground!=old_foreground)
{
if (pause_on_blur)
{
if (menustart.paused)
{
menustart.seek(0);
menustart.play();
}
else if (menuloop.paused) menuloop.play_looped();
else if (won.paused) won.play();
if (is_game)
{
if (output>0) wait(300);
say ("Odpauzuj hru.", true, false);
}
}
else set_sound_master_volume(loudness);
}
output_check_frames++;
if (output_check_frames >= 3) checkup();
if (foreground and foreground!=old_foreground and (menu.running or menu_question!="" or is_optionsmenu or is_learnmenu or is_conmenu or is_custmenu or is_statmenu or is_readmenu))
{
wait_keys();
if (output>0)
{
wait(250);
silence();
}
if (@top_menu!=null)
{
if (menu_question!="") say (menu_question, true, false);
top_menu.speak_item=true;
}
}
old_foreground=foreground;
if (keyhelp) return;
if (singlekey (KEY_DELETE) or (mod_ctrl() and mod_shift() and mod_alt() and down_keys() == 3))
{
silence();
if (is_custmenu) silence_custmenu();
}
}

void closekey()
{
if (menu_question!="") return;
modifiers();
if (!foreground) return;
uint8 system=0;
if (PLATFORM.lower().find ("Darwin") >-1) system=2;
else if (!system_is_windows) system=1;
bool wants_close=false;
if (system<2 and !wants_close)
{
if (((keyboard_modifiers & KEYMOD_LALT)>0 and key_down (KEY_F4)) or ((keyboard_modifiers & KEYMOD_CTRL)>0 and key_down (KEY_Q)) and down_keys()==2) wants_close=true;
}
else if (!wants_close)
{
if ((keyboard_modifiers & KEYMOD_LGUI)>0 and key_down (KEY_Q) and down_keys()==2) wants_close=true;
}
if (wants_close)
{
if (menu_question == "Ukončit program?") return;
if (ask ("Ukončit program?", false, !is_game) == 1)
{
if (!play_outro) stop_menu_music();
silence (true);
if (!onboarding) quit();
else exit();
}
}
}

bool singlekey (int key)
{
if (key_pressed (key) and down_keys() == 1) return true;
return false;
}

bool lone (int key, uint8 length=2)
{
if (key_pressed (key))
{
if (length == 0 or down_keys() <= length) return true;
return false;
}
return false;
}

void wait_keys()
{
while (true)
{
if (keys_down().is_empty()) break;
wait(1);
}
ui_help_timer.restart();
get_characters();
}

void history_keys()
{
bool ctrl=mod_ctrl(), shift=mod_shift(), alt=mod_alt();
if (alt or down_keys() > 3) return;
if (lone (KEY_W, 3))
{
if (history.is_empty()) say ("Dosud nic neřečeno.", true, false, false);
else if (!ctrl and !shift) say (history[history_index], true, false, false);
else if (ctrl and !shift) copy (history[history_index]);
else if (!ctrl and shift) spell (history[history_index]);
else if (ctrl and shift) read_menu (history[history_index]);
}
bool pressed=false;
if (singlekey (KEY_HOME))
{
silence();
if (history.is_empty()) say ("Dosud nic neřečeno.", true, false, false);
else if (down_keys() == 1 and history_index != 0)
{
history_index=0;
pressed=true;
}
else history_edge();
}
else if (singlekey (KEY_END))
{
silence();
if (history.is_empty()) say ("Dosud nic neřečeno.", true, false, false);
if (down_keys() == 1 and history_index != history.length()-1)
{
history_index=history.length()-1;
pressed=true;
}
else history_edge();
}
else if (singlekey (KEY_PAGEUP))
{
silence();
if (history.is_empty()) say ("Dosud nic neřečeno.", true, false, false);
if (history_index > 0)
{
pressed=true;
history_index--;
}
else history_edge();
}
else if (singlekey (KEY_PAGEDOWN))
{
silence();
if (history.is_empty()) say ("Dosud nic neřečeno.", true, false, false);
if (history_index < history.length()-1)
{
history_index++;
pressed=true;
}
else history_edge();
}
if (pressed and !history.is_empty() and history_old_index != history_index)
{
history_old_index=history_index;
bool first=true;
if (history_index == 0)
{
say ("Nejnovější.", true, false, false);
first=false;
}
else if (history_index == history.length() -1)
{
say ("Nejstarší.", true, false, false);
first=false;
}
say (history[history_index], first, false, false);
}
}

void history_edge()
{
if (!history.is_empty()) play_stat ("edge");
}

