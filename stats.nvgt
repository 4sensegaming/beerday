};

class stat
{
string name="", ui_name="";
uint64 content;
uint8 category=0, section=1;

string render(bool copied=false)
{
if (content==0 and !show_empty_stats) return "";
string result="";
if (instr(name, "duration") or instr(name, "longest") or instr(name, "patient") or instr(name, "runtime"))
{
bool is_longest=true;
if (instr(name, "patient")) is_longest=false;
if (instr(name, "jukebox")) is_gallery=true;
if (content>0)
{
if (copied) result=ui_name+": "+get_time(is_longest, content, true);
else result=name+"|"+ui_name+": "+get_time(is_longest, content, true)+"| |"+section;
}
else
{
if (copied) result=ui_name+": Dosud žádný čas";
else result=name+"|"+ui_name+": Dosud žádný čas.| |"+section;
}
}
else if (copied) result=ui_name+": "+content;
else result=name+"|"+ui_name+": "+content+"| |"+section;
is_gallery=false;
return result;
}

int opCmp(stat@ handle)
{
string this=name, other=handle.name;
if (this>other) return 1;
else if (this==other) return 0;
else return -1;
}
}

stat[] stats;

stat@ find_stat(string name)
{
stat@ handle=null;
uint sl=stats.length();
for (uint i=0; i<sl; i++)
if (stats[i].name==name) return stats[i];
return handle;
}

uint64 get_stat(string name)
{
stat@ temp=find_stat(name);
if (@temp==null)
{
warning("Statistiku "+name+" se nepovedlo přečíst.");
return 0;
}
return temp.content;
}

void set_stat(string name, uint64 value, bool overwrite=false)
{
if ((is_tutorial or value==0) and (name!="runtime" and name!="run_times")) return;
stat@ handle=find_stat(name);
if (@handle==null)
{
warning("Statistiku "+name+" se nepovedlo zapsat.");
return;
}
if (!overwrite) handle.content+=value;
else if (value>handle.content) handle.content=value;
}

void create_stats()
{
datastream@ f=pack.get_file("stats.dat");
string raw=string_aes_decrypt(f.read(), scramble());
if (raw=="")
{
warning("Chyba při načítání statistik:\r\n"+get_last_error());
return;
}
string[] split=raw.split("\r\n", true);
uint l=split.length();
stats.reserve(l);
for (uint i=0; i<l; i++)
{
string[] single_stat=split[i].split("\t", true);
uint8 ssl=single_stat.length();
if (ssl<3 or ssl>4)
{
warning("Nesprávná statistika na řádku "+(i+1)+". Má "+ssl+" prvků.");
return;
}
stat new;
new.name=single_stat[0];
new.ui_name=single_stat[1];
new.content=0;
new.category=uint8(parse_int(single_stat[2]));
if (ssl==4) new.section=uint8(parse_int(single_stat[3]));
stats.insert_last(new);
}
l=all_beers.length();
uint nl=non_alco.length();
uint category=category_sections.length()-1, last_section=2;
for (uint i=0; i<l; i++)
{
category_sections[category]+=all_beers[i]+";";
stat new;
new.content=0;
new.ui_name="Dohromady";
new.name="single_"+all_beers[i];
new.category=category;
new.section=last_section;
stats.insert_last(new);
for (uint8 j=0; j<l; j++)
{
if (all_beers[i]==all_beers[j]) continue;
stat mix;
mix.content=0;
mix.name="mixed_"+all_beers[i]+"_"+all_beers[j];
string mixed_name=all_beers7[j];
if (is_s_or_z_sound(mixed_name)) mixed_name="Se "+mixed_name;
else mixed_name="S "+mixed_name;
mix.ui_name=mixed_name;
mix.category=category;
mix.section=last_section;
stats.insert_last(mix);
}
for (uint8 k=0; k<nl; k++)
{
stat mix;
mix.content=0;
mix.name="mixed_"+all_beers[i]+"_"+non_alco[k];
string mixed_name=non_alco7[k];
if (is_s_or_z_sound(mixed_name)) mixed_name="Se "+mixed_name;
else mixed_name="S "+mixed_name;
mix.ui_name=mixed_name;
mix.category=category;
mix.section=last_section;
stats.insert_last(mix);
}
last_section++;
}
for (uint i=0; i<nl; i++)
{
category_sections[category]+=non_alco[i]+";";
stat new;
new.content=0;
new.ui_name="Dohromady";
new.name="single_"+non_alco[i];
new.category=category;
new.section=last_section;
stats.insert_last(new);
for (uint8 j=0; j<l; j++)
{
stat mix;
mix.content=0;
mix.name="mixed_"+non_alco[i]+"_"+all_beers[j];
string mixed_name=all_beers7[j];
if (is_s_or_z_sound(mixed_name)) mixed_name="Se "+mixed_name;
else mixed_name="S "+mixed_name;
mix.ui_name=mixed_name;
mix.category=category;
mix.section=last_section;
stats.insert_last(mix);
}
last_section++;
}
}

void save_stats()
{
update_runtime();
uint l=stats.length();
for (uint i=0; i<l; i++) profile.set(stats[i].name, stats[i].content);
profile.set("did_tutorial", did_tutorial);
}

void load_stats()
{
uint l=stats.length();
for (uint i=0; i<l; i++)
if (profile.exists(stats[i].name)) profile.get(stats[i].name, stats[i].content);
if (profile.exists("did_tutorial")) profile.get("did_tutorial", did_tutorial);
}

string prefix_mode()
{
string prefix;
if (endless) prefix="endless_";
else if (freeplay) prefix="free_";
else prefix="normal_";
if (hardcore) prefix+="hardcore_";
return prefix;
}

void make_stats(bool exited)
{
if (!can_write) return;
update_runtime();
if (is_tutorial)
{
save_stats();
return;
}
update_customer_stats();
string prefix=prefix_mode();
set_stat(prefix+"played_total", 1);
set_stat(prefix+"played_diff"+difficulty, 1);
set_stat(prefix+"duration_total", elapsed);
set_stat(prefix+"duration_diff"+difficulty, elapsed);
set_stat(prefix+"longest_total", elapsed, true);
set_stat(prefix+"longest_diff"+difficulty, elapsed, true);
if (elapsed>=limit and !endless and !freeplay) prefix+="completed_";
else
{
if (exited) prefix+="quit_";
else prefix+="lost_";
}
set_stat(prefix+"total", 1);
set_stat(prefix+"diff"+difficulty, 1);
set_stat(prefix+"duration", elapsed);
set_stat(prefix+"longest", elapsed, true);
if (autoplay) return;
if (gratuity>0)
{
set_stat("gratuity", gratuity);
set_stat("most_gratuity_once", most_gratuity_once, true);
set_stat("most_gratuity_total", most_gratuity_total, true);
}
set_stat("most_paid", most_paid, true);
set_stat("customers_total", spawned);
set_stat("customers_most", most, true);
set_stat("fled_total", fled_total);
set_stat("happy_total", fled_total-fled);
set_stat("thrown_total", thrown);
set_stat("hurt_total", hurt);
set_stat("stunned_total", stunned);
set_stat("steps_total", steps);
set_stat("served_total", served);
set_stat("served_most", served, true);
set_stat("puked_total", total_puked);
set_stat("puked_most", total_puked, true);
set_stat("served_correct", served_correct);
set_stat("mistakes_total", mistakes);
set_stat("undermeasures", undermeasures);
set_stat("dirty_drinks", dirty_drinks);
set_stat("single_drinks", single_drinks);
set_stat("mixed_drinks", mixed_drinks);
set_stat("money", money);
set_stat("earned_most", money, true);
find_stat("money_total").content=money_total;
set_stat("jukebox_earned_total", earned_jukebox);
set_stat("jukebox_earned_once", earned_jukebox, true);
set_stat("jukebox_earned_most", earned_jukebox_most_customer, true);
set_stat("jukebox_played_total", played_jukebox);
set_stat("jukebox_played_player", played_jukebox_player);
set_stat("jukebox_played_customers", played_jukebox_customers);
set_stat("trips_total", total_trips);
set_stat("falls_total", total_falls);
set_stat("patient_total", most_patient, true);
set_stat("most_beers_total", most_beers, true);
set_stat("longest_total", longest, true);
set_stat("washed_total", washed);
set_stat("dirty_left_total", say_dirty(false));
set_stat("broken_total", broken);
set_stat("fallen_total", fallen);
set_stat("broken_nonempty", broken_nonempty);
set_stat("fallen_nonempty", fallen_nonempty);
set_stat("dried", dried);
set_stat("replaced_total", replaced);
set_stat("helpers_total", helpers);
set_stat("pourers_total", pourers);
set_stat("givers_total", givers);
set_stat("cleaners_total", cleaners);
set_stat("barrelers_total", barrelers);
set_stat("emptiers_total", emptiers);
set_stat("calmers_total", calmers);
set_stat("throwers_total", throwers);
set_stat("roamers_total", roamers);
set_stat("chasers_total", chasers);
set_stat("slept_total", slept);
set_stat("most_queued", most_queue, true);
set_stat("most_hits", most_hits, true);
set_stat("player_hits", player.hits);
set_stat("most_player_hits", player.hits, true);
}

void view_stats()
{
silence();
if (!show_empty_stats and is_empty_category(-1))
{
say("Zatím nejsou uloženy žádné statistiky.", true, false, true);
return;
}
dynamic_menu stat_menu;
int8 tempres=1;
while (tempres!=0)
{
string[] categories=stats_menu;
uint8 l=categories.length();
for (uint8 i=1; i<l-2; i++)
{
if (is_empty_category(i)) categories[i]+="|V této kategorii zatím nejsou uloženy žádné statistiky.";
else categories[i]+="| ";
categories[i]+="|1|2|1";
if (!show_empty_stats and is_empty_category(i)) categories[i]+="|1";
}
if (is_empty_category(-1))
{
categories[categories.length()-2]+="|Zatím nejsou uloženy žádné statistiky.|1|2|0|1";
categories[categories.length()-1]+=" Zatím nejsou uloženy žádné statistiky.|1|2|1|1";
}
else categories[categories.length()-1]+="|1|2|1";
tempres=make_menu(categories, tempres, stat_menu);
string item=stat_menu.get_item_name(tempres);
if (instr(item, "copy")) copy_stats();
else if (instr(item, "clear"))
{
bool cleared=clear_stats();
if (cleared)
{
tempres=1;
if (!show_empty_stats) break;
}
}
else if (tempres>0) view_category(tempres);
}
}

void view_category(uint8 category)
{
silence();
if (is_empty_category(category))
{
say("V této kategorii zatím nejsou uloženy žádné statistiky.", true, false, true);
if (!show_empty_stats) return;
}
uint l=stats.length();
string[] renders;
renders.reserve(l);
renders.resize(0);
update_runtime();
string[] category_header=stats_menu[category].split("|", true);
renders.insert_last("Statistiky z kategorie "+category_header[1]);
for (uint i=0; i<l; i++)
if (stats[i].category==category and (stats[i].content>0 or show_empty_stats))
{
string render=stats[i].render();
if (render!="") renders.insert_last(render);
}
string[] section_list=category_sections[category].split(";", true);
dynamic_menu cat_menu;
is_statmenu=true;
make_menu(renders, 1, @cat_menu, true, section_list);
is_statmenu=false;
}

bool clear_stats()
{
wait_keys();
if (ask("Chceš opravdu vymazat všechny statistiky? Tím přijdeš o veškerý dosavadní postup ve hře, to znamená o vydělané peníze, nakoupené varianty a vylepšení hry, získané odměny a o všechno ostatní. Budeš muset začít hrát znovu od úplného začátku, tedy od prvního seznámení s hrou. Tento krok nejde odvolat, ale nevymaže uložená nastavení - které zvuky se mají a které nemají přehrávat, co a jakým způsobem se má číst a další.")==2) return false;
uint l=stats.length();
for (uint i=0; i<l; i++) stats[i].content=0;
save_stats();
save_profile();
say("Statistiky smazány.", true, false, true);
return true;
}

void copy_stats()
{
string parsed="";
int l=stats.length(), last_category=-1, last_section=-1;
string[] sections;
for (uint i=0; i<l; i++)
if (stats[i].content>0 or show_empty_stats)
{
if (stats[i].category!=last_category)
{
last_category=stats[i].category;
if (parsed!="") parsed+="\r\n";
string[] category_header=stats_menu[last_category].split("|", true);
parsed+="# "+category_header[1]+"\r\n";
sections=category_sections[last_category].split(";", true);
}
if (!sections.is_empty() and last_section!=stats[i].section and sections[0]!="")
{
last_section=stats[i].section;
int section_index=last_section-1;
if (section_index>=0 and section_index<int(sections.length()) and sections[section_index]!="") parsed+="## "+sections[section_index]+"\r\n";
}
parsed+=stats[i].render(true)+"\r\n";
}
if (parsed.length()>=2) parsed=parsed.substr(0, parsed.length()-2);
clipboard_set_text(parsed);
say("Statistiky zkopírovány.", true, false, true);
}

void update_customer_stats()
{
uint8 c=customers.length();
most_hits=0;
for (uint8 i=0; i<c; i++)
{
character@ h=customers[i];
if (h.alive>longest) longest=h.alive;
if (h.hits>most_hits) most_hits=h.hits;
}
}

void update_runtime()
{
uint64 time=runtime.elapsed/1000;
time*=fps;
set_stat("runtime", time);
runtime.restart();
if (get_stat("run_times")==0) set_stat("run_times", 1);
}

bool is_empty_category(int category)
{
uint l=stats.length();
for (uint i=0; i<l; i++)
{
if (category==-1 and stats[i].category==1) continue;
if ((category==-1 or stats[i].category==category) and stats[i].content>0) return false;
}
return true;
}
