#include "sound_pool.nvgt"
#include "music.nvgt"

sound_pool pool(200), things(200);
sound@[] preloads;
tts_voice fallback_voice;
uint output_check_frames=0;
string[] history;
int ambience=-1, nearby=-1, history_index, history_old_index;
int8 output=0;
bool hooked=false;
string[] files;
string last_text="", reader_name="";
sound won, custbeep, doingsound, customer_here;
string[] menu_sounds={"enter", "esc", "move", "turn", "prompt", "sub", "edge", "error"};

string randomize (string file)
{
int8 start_index=-1, last_index=-1;
uint count=0;
uint l=files.length();
for (uint x=0; x<l; x++)
if (instr (files[x], file))
{
count++;
if (start_index == -1) start_index=1;
else last_index=count;
}
if (count > 1) file+=random (start_index, last_index);
return file;
}

void silence (bool full=false)
{
get_characters();
if (output == 0 and fallback_voice.speaking) fallback_voice.stop();
else if (output > 0 and foreground) screen_reader_silence();
if (full)
{
pool.destroy_all();
things.destroy_all();
silence_menu();
}
}

bool say (string phrase, bool interrupt=true, bool remember=true, bool pause=false)
{
if (pause) wait_keys();
if (output == 0)
{
if (interrupt) fallback_voice.speak_interrupt (phrase);
else fallback_voice.speak (phrase);
}
else screen_reader_speak (phrase, interrupt);
if (phrase != last_text and !instr (phrase, "Pokračuj enterem")) last_text=phrase;
if (play_say and phrase != "" and remember and !paused and !menu.running and !is_custmenu and !keyhelp) play_stat ("say");
if (remember and use_history)
{
history.insert_at (0, phrase);
if (history_entries>0 and history.length() > history_entries) history.resize(history_entries);
history_index=0;
history_old_index=0;
}
if (enable_debugging and debug_speech) clipboard_set_text (phrase);
if (pause)
{
if (output == 0) return wait_speech();
else wait_reader (phrase);
}
return true;
}

void fadeout (double volume_step=0.5, bool enable_close=true, bool forced=false)
{
if (loudness <= minvol) return;
if (!forced)
{
uint l=pool.items.length(), count=0;
for (uint i=0; i<l; i++)
if (pool.sound_is_playing(i)) count++;
l=things.items.length();
for (uint i=0; i<l; i++)
if (things.sound_is_playing(i)) count++;
if (count==0 and !menuloop.playing and !menustart.playing and !won.playing and !is_gallery) return;
}
frame.restart();
while (get_sound_master_volume()>minvol)
{
if (frame.elapsed >= frame_ms)
{
frame.restart();
wait (5);
if (enable_close) closekey();
double curvol=get_sound_master_volume();
curvol-=volume_step*(60.0/fps);
set_sound_master_volume (curvol);
}
}
silence(true);
if (menuloop.playing or menustart.playing) stop_menu_music();
set_sound_master_volume (loudness);
garbage_collect();
}

void fadein (double volume_step=0.5)
{
if (loudness <= minvol) return;
garbage_collect();
set_sound_master_volume(minvol-10);
frame.restart();
while (get_sound_master_volume() < loudness)
{
if (frame.elapsed >= frame_ms)
{
frame.restart();
wait (5);
closekey();
double curvol=get_sound_master_volume();
curvol+=volume_step*(60.0/fps);
set_sound_master_volume (curvol);
}
}
}

bool wait_sound (string snd, bool fade=true, bool enable_close=true, double pan=0)
{
wait_keys();
sound oneshot;
oneshot.stream (snd+ext);
if (pan<stereo_left) pan=stereo_left;
else if (pan>stereo_right) pan=stereo_right;
if (stereo_center!=0)
{
if (stereo_center>pan) pan+=stereo_center;
else pan-=stereo_center;
}
oneshot.pan=pan;
oneshot.play();
while (oneshot.playing)
{
wait(5);
menu_music();
if (enable_close) closekey();
if (!onboarding and (singlekey (KEY_RETURN) or singlekey (KEY_NUMPAD_ENTER) or singlekey (KEY_SPACE) or singlekey (KEY_ESCAPE)))
{
if (fade) fadeout();
else oneshot.close();
return false;
}
}
return true;
}

bool wait_speech()
{
wait_keys();
while (fallback_voice.speaking)
{
wait(5);
closekey();
menu_music();
if (singlekey (KEY_RETURN) or singlekey (KEY_NUMPAD_ENTER) or singlekey (KEY_SPACE) or singlekey (KEY_ESCAPE))
{
silence();
wait_keys();
return false;
}
}
wait_keys();
return true;
}

void checkup()
{
output_check_frames=0;
output=0;
reader_name="";
if (hooked and (!system_is_windows or forced_output or !foreground))
{
uninstall_keyhook();
hooked=false;
}
if (!forced_output)
{
reader_name=screen_reader_detect();
if (reader_name=="JAWS") output=1;
else if (reader_name=="SYSTEM_ACCESS") output=2;
else if (reader_name=="WINDOW-EYES") output=3;
else if (reader_name=="NVDA") output=4;
else if (reader_name=="ORCA") output=5;
else if (reader_name=="VOICEOVER") output=6;
if (!hooked and system_is_windows and reader_name == "JAWS" and foreground)
{
if (install_keyhook()) hooked=true;
}
else if (hooked and (!system_is_windows or reader_name != "JAWS" or !foreground))
{
uninstall_keyhook();
hooked=false;
}
}
}

void changed_output()
{
if (output == 0 and fallback_voice.voice_count==0)
{
alert ("Chyba!", "Není spuštěn žádný kompatibilní odečítač obrazovky ani systémový hlas. Program se ukončí.");
quit (true);
}
}

void preload_audio()
{
string[] skip={"beep", "achievement", "bought", "nomoney", "start", "logo", "gameover", "lose", "win", "winsong", "menustart", "menuloop", "minleft", "timesup", "customer"};
timer loader;
uint l=files.length();
preloads.reserve(l);
for (uint i=0; i<l; i++)
{
if (skip.find(files[i])>-1) continue;
sound new;
preloads.insert_last (new);
uint index=preloads.length()-1;
if (instr (files[i], "music")) preloads[index].stream (files[i]);
else preloads[index].load (files[i]);
if (!preloads[index].active)
{
warning ("Nepodařilo se načíst zvuk "+files[i]+".");
exit();
}
}
}

void play_move()
{
silence_menu();
if (!play_menu_sounds or (is_gallery and menu_question!="")) return;
play_stat ("move", false, false, menu_sounds_vol);
}

void play_turn()
{
silence_menu();
if (!play_menu_sounds or (is_gallery and menu_question!="")) return;
play_stat ("turn", false, false, menu_sounds_vol);
}

void play_enter()
{
silence_menu();
if (!play_menu_sounds or (is_gallery and menu_question!="")) return;
play_stat ("enter", false, false, menu_sounds_vol);
}

void play_esc()
{
silence_menu();
if (!play_menu_sounds or (is_gallery and menu_question!="")) return;
play_stat ("esc", false, false, menu_sounds_vol);
}

void silence_menu()
{
silence();
uint8 msl=menu_sounds.length();
for (uint8 i=0; i<msl; i++)
{
int8 msp=pool.get_sound_by_name (menu_sounds[i]);
if (msp>-1 and pool.sound_is_playing(msp)) pool.destroy_sound (msp);
}
if (is_custmenu) silence_custmenu();
if (is_learnmenu) pool.destroy_all();
}

void wait_menu()
{
garbage_collect();
uint8 msl=menu_sounds.length();
for (uint8 i=0; i<msl; i++)
{
int8 msh=pool.get_sound_by_name (menu_sounds[i]);
while (msh>-1 and pool.sound_is_playing(msh)) wait(5);
}
}

void play_inmenu()
{
if (!play_menu_sounds or (is_gallery and menu_question!="")) return;
play_stat ("prompt", false, false, menu_sounds_vol);
}

void play_submenu()
{
if (!play_menu_sounds or (is_gallery and menu_question!="")) return;
play_stat ("sub", false, false, menu_sounds_vol);
}

void play_edge()
{
if (!play_menu_sounds or (is_gallery and menu_question!="")) return;
silence_menu();
play_stat ("edge", false, false, menu_sounds_vol);
}

int play_stat (string sound, bool looping=false, bool persistent=false, double thisvol=0)
{
return pool.play_stationary_extended (randomize (sound) +ext, looping, 0, stereo_center, thisvol, 100, persistent);
}

void silence_custmenu()
{
if (custbeep.playing) custbeep.stop();
custchanged=false;
doingsound.close();
if (customer_here.playing) customer_here.stop();
}

void character_position (character@ handle, bool looping)
{
position_sound_2d (custbeep, player.x, player.y, handle.x, handle.y, pool.pan_step, pool.volume_step, pool.behind_pitch_decrease);
custbeep.pitch=100 -abs(player.y/2);
handle.is_player?custbeep.volume=0:custbeep.volume=menu_sounds_vol;
looping?custbeep.play_looped():custbeep.play();
}

void clear_item_loops()
{
if (play_all_items or !changed_item_loops) return;
uint l=mugs.length();
for (uint8 i=0; i<l; i++)
{
if (mugs[i].slot>-1 and things.sound_is_active(mugs[i].slot)) things.destroy_sound (mugs[i].slot);
mugs[i].slot=-1;
if (play_mugloop and @mugs[i].owner==null and sink.washer.find(mugs[i])==-1) mugs[i].start_loop();
}
l=barrels.length();
for (uint8 i=0; i<l; i++)
{
if (barrels[i].slot>-1 and things.sound_is_active (barrels[i].slot)) things.destroy_sound (barrels[i].slot);
barrels[i].slot=-1;
if (play_barrelloop and @barrels[i].owner==null and barrels[i].falling==0) barrels[i].start_loop();
}
changed_item_loops=false;
}

void update_ambience()
{
double l=-20+player.y;
l+=(customers.length()-player.count_state(idle).length()-player.count_state(closing).length());
uint cl=customers.length();
for (uint i=0; i<cl; i++)
if (customers[i].y<0) l--;
if (ambience>-1 and !pool.items.is_empty() and pool.sound_is_active(ambience)) pool.items[ambience].handle.volume=l;
}

void update_stereo()
{
if (!is_game) return;
uint l=pool.items.length();
for (uint i=0; i<l; i++)
{
if (mono_audio and @pool.items[i].handle!=null) pool.items[i].handle.pan=0;
else if (stereo_invert and @pool.items[i].handle!=null) pool.items[i].handle.pan=-pool.items[i].handle.pan;
else if (@pool.items[i].handle!=null) pool.update_sound_start_values (i, stereo_center, pool.items[i].handle.volume, pool.items[i].handle.pitch);
}
l=things.items.length();
for (uint i=0; i<l; i++)
{
if (mono_audio and @things.items[i].handle!=null) things.items[i].handle.pan=0;
else if (stereo_invert and @things.items[i].handle!=null) things.items[i].handle.pan=-things.items[i].handle.pan;
else if (@things.items[i].handle!=null) things.update_sound_start_values (i, stereo_center, things.items[i].handle.volume, things.items[i].handle.pitch);
}
}

void update_volumes()
{
if (!is_game) return;
uint8 l=pool.items.length();
for (uint8 i=0; i<l; i++)
{
sound_pool_item@ snd=pool.items[i];
string fn=snd.filename;
sound@ sndh=snd.handle;
if (@sndh!=null and fn!="" and sndh.paused)
{
if (instr (fn, "music")) pool.update_sound_start_values (i, snd.start_pan, gamemusic_vol, snd.start_pitch);
else if (fn=="beep") pool.update_sound_start_values (i, snd.start_pan, nearby_vol, snd.start_pitch);
else if (instr (fn, ".wav")) pool.update_sound_start_values (i, snd.start_pan, vocals_vol, snd.start_pitch);
}
}
l=things.items.length();
for (uint8 i=0; i<l; i++)
{
sound_pool_item@ snd=things.items[i];
string fn=snd.filename;
sound@ sndh=snd.handle;
if (@sndh!=null and fn!="" and sndh.paused)
{
if (instr (fn, "mugloop")) things.update_sound_start_values (i, snd.start_pan, mugloop_vol, snd.start_pitch);
else if (fn=="barrel") things.update_sound_start_values (i, snd.start_pan, barrelloop_vol, snd.start_pitch);
}
}
l=mugs.length();
for (uint8 i=0; i<l; i++) mugs[i].vol=mugloop_vol;
l=barrels.length();
for (uint8 i=0; i<l; i++) barrels[i].vol=barrelloop_vol;
}