optmenu.insert_last ("customers_jukebox|Zákazníci smìjí pouštìt hudbu|Kdy je toto nastavení vypnuté a zároveò je vypnutá i náhodná hudba, nebude z jukeboxu nikdy samo od sebe hrát nic. Ty z nìj ale mùeš nìco pustit kdykoliv, pokud na to máš peníze.");
if (!play_game_music) optmenu[optmenu.length()-1]+=no_jukebox;
optmenu[optmenu.length()-1]+="|2|"+enable_jukebox+"|0|"+!play_game_music;
optmenu.insert_last ("speak_impatient|Zákazník brzy ztratí trpìlivost| |3|"+say_impatient);
optmenu.insert_last ("speak_errors|Slovní popisy chyb|Pokud je toto nastavení vypnuté, ozve se vdycky, kdy se pokusíš udìlat nìco, co zrovna nejde, jako tøeba sebrat další pùllitr, kdy u jich neseš sedm), jen zvuková vıstraha. Pøíslušnı zvuk najdeš v nabídce seznámení se zvuky.|3|"+speak_errors);
optmenu.insert_last("speak_step|Pøedmìty pøi chùzi|Kdy je toto nastavení vypnuté a ty budeš chtít zjistit, jestli jsou na políèku, kde právì stojíš, nìjaké pùllitry nebo sudy, budeš to muset udìlat pokadé ruènì.|3|"+speak_step);
if (!onboarding)
{
optmenu.insert_last ("restore_game_defaults|Obnovit vıchozí nastavení hry");
if (is_game) optmenu[optmenu.length()-1]+="|Obtínost, reim hry a zpùsob vybírání piv na èepu nemùeš mìnit bìhem hry.";
else optmenu[optmenu.length()-1]+="| ";
optmenu[optmenu.length()-1]+="|4";
}
else optmenu.insert_last ("continue|Pokraèovat| |4");
if (tempres == -1) tempres=1;
tempres=make_menu (optmenu, tempres, tempmenu, first, sections, !first);
first=false;
item=tempmenu.get_item_name (tempres);
if (instr (item, "step")) speak_step=!speak_step;
else if (instr (item, "error")) speak_errors=!speak_errors;
else if (instr (item, "selection"))
{
set_selection();
first=true;
}
else if (instr (item, "clear_drinks"))
{
clear_drinks();
first=true;
}
else if (instr (item, "choose"))
{
choose_beers_manually();
first=true;
}
else if (instr (item, "name_customers")) name_customers=!name_customers;
else if (instr (item, "tips")) show_tips=!show_tips;
else if (instr (item, "impatient")) say_impatient=!say_impatient;
else if (instr (item, "random_music"))
{
play_random_music=!play_random_music;
if (!play_random_music and music>-1 and playlist.is_empty() and !repeat_playlist)
{
pool.destroy_sound (music);
music=-1;
last_track="";
}
}
else if (instr (item, "customers_jukebox")) enable_jukebox=!enable_jukebox;
else if (instr (item, "game_defaults"))
{
restore_game_defaults (false);
return;
}
else if (instr (item, "continue")) break;
}
}

