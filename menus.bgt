optmenu.insert_last ("play_single_loop|Více pøedmìtù na stejném místì|Kdy toto nastavení vypneš a na nìkterém políèku budou napøíklad tøi pùllitry najednou, bude se z nìj ozıvat pouze jeden zvuk pùllitru. Úplnì se pøestane ozıvat, teprve a na tomto políèku nezùstanou ádné pùllitry. Vypnutím tohoto nastavení tak mùeš docílit menšího hluku pøi høe, co mùe bıt nìkdy pøehlednìjší.|1|"+play_all_items+"|0|"+(!play_mugloop and !play_barrelloop));
optmenu.insert_last ("customer_beep|První zákazník ve frontì nebo sledovanı zákazník|Pokud právì nikoho nesleduješ, bude se zvuk ozıvat  vdy jen poblí toho zákazníka, kterı je zrovna první ve frontì. Pokud nìkoho sledovat zaèneš, bude se zvuk ozıvat vdy jen z pozice sledovaného zákazníka.|1|"+cue);
optmenu.insert_last ("play_sr_prompt|Zvuková vızva k pokraèování|Pokud hra mluví prostøednictvím odeèítaèe, není na nìkterıch místech moné pokraèovat k dalšímu kroku bez potvrzení enterem. V nabídce nastavení rozhraní si mùeš ještì zvláš nastavit slovní upozornìní místo zvukového.|1|"+play_sr_prompt+"|0|"+forced_output);
optmenu.insert_last ("play_utterance|Zvuk nové promluvy v historii øeèi|Kdy je toto nastavení zapnuté, ozve se zvuk vdycky, kdy program vysloví nìkterou hlášku, která se dá zopakovat v historii øeèi. Dostaneš tak upozornìní, e hra øekla nìco, co by bylo dobré nepøeslechnout. To se mùe hodit v nároènìjších, rychlejších a hluènìjších hrách. Pøíslušnı zvuk najdeš v nabídce Seznámení se zvuky.|1|"+play_say);
optmenu.insert_last ("steps_overall|Všechny kroky celkovì| |2|"+play_steps);
