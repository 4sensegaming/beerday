else if (question!="") msg+="znìní otázky a ";
else msg+="vybrané poloky.\r\n";
if (is_learnmenu) msg+="Enter: Pøehrání vybraného zvuku. Pokud má zvuk více variant, budou se pøehrávat náhodnì.\r\n";
else if (is_custmenu) msg+="Enter: Nabídka akcí pro vybraného zákazníka.\r\n";
else if (!is_statmenu and !is_readmenu) msg+="Enter: Potvrzení vybrané poloky.\r\n";
msg+="Houm: ";
if (is_readmenu) msg+="První øádek.\r\n";
else msg+="První poloka.\r\n";
msg+="End: ";
if (is_readmenu) msg+="Poslední øádek.\r\n";
else msg+="Poslední poloka.\r\n";
if (top_menu.get_item_count()>10)
{
msg+="Pejd ap: Skok o 10 ";
if (is_readmenu) msg+="øádkù";
else msg+="poloek";
msg+=" nahoru.\r\nPejd daun: Skok o 10 ";
