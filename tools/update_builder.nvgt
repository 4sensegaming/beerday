const string source="beerday.nvgt", exec=read_environment_variable("windir")+"/explorer.exe", winscp_path="C:/Users/lukas/AppData/Local/Microsoft/WindowsApps/WinSCP.exe", nvgt="c:/nvgt/nvgt.exe";
#include "../build_constants.nvgt"
#include "rootlib.nvgt"
#include "motdlib.nvgt"
#include "packerlib.nvgt"

bool compile_target(string mode, string target, string output_file, string destination)
{
if (file_exists(output_file)) file_delete(output_file);
if (file_exists(destination)) file_delete(destination);
string args="-p"+target+" "+mode+" "+source;
if (!run(nvgt, args, true, false) or !file_exists(output_file)) return false;
if (!file_copy(output_file, destination, false)) return false;
file_delete(output_file);
return true;
}

void main()
{
chdir(get_project_root());
show_window("Beerday Update Builder");
if (question("Build", "Verze: "+version+"\r\nDatum: "+build_day+". "+build_month+". "+build_year+", "+build_hour+":"+build_minute+"\r\nPokračovat?") == 2) return;
if (question("Zadat zprávu dne?", "") == 1)
{
build_motd (true);
show_window("Beerday Update Builder");
}
if (question("Zkontrolovat log?", "") == 1) run(exec, "bin\\changelog.html", false, true);
if (question("Zkontrolovat roadmapu?", "") == 1) run(exec, "bin\\roadmap.html", false, true);
build_pack (true, get_project_root());
file_put_contents ("bin/lastver.dat", version+"\t"+build_day+"\t"+build_month+"\t"+build_year+"\t"+build_hour+"\t"+build_minute);
string compile=question("Release build?", "") == 1 ? "-c -q" : "-C -q";
string[] targets={"windows", "linux", "mac"};
string[] produced={"beerday.zip", "beerday.tar.gz", "beerday.iso"};
string[] staged={"bin/beerday.zip", "bin/beerday.tar.gz", "bin/beerday.iso"};
string debug=file_get_contents ("debugging.nvgt");
debug.replace ("enable_debugging=true", "enable_debugging=false", true);
file_put_contents ("debugging.nvgt", debug);
for (uint i=0; i<targets.length(); i++) compile_target(compile, targets[i], produced[i], staged[i]);
if (question("Uploadnout?", "") == 1) run(winscp_path, "", false, false);
if (question ("Vytvořit GitHub release?", "")==1) urlopen ("https://github.com/4sensegaming/beerday/releases/new");
}