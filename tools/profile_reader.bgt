void main()
{
file f;
if (!f.open (DIRECTORY_LOCAL_APPDATA+"/4Sense Gaming/Beerday/profile.dat", "rb"))
{
alert ("Profile not found.", "");
}
string raw=string_decrypt (f.read(), scramble());
if (raw=="")
{
alert ("Empty string", get_last_error_text());
}
dictionary profile;
profile=deserialize (raw);
if (profile.is_empty())
{
alert ("No keys.", get_last_error_text());
}
string[] keys=profile.get_keys();
string result="";
uint l=keys.length();
for (uint i=0; i<l; i++)
{
string value="";
string sval;
if (profile.get (keys[i], sval)) value=keys[i]+": "+sval;
if (value=="")
{
int ival;
if (profile.get (keys[i], ival)) value=keys[i]+": "+ival;
}
if (value=="")
{
bool bval;
if (profile.get (keys[i], bval)) value=keys[i]+": "+bval;
}
if (value=="")
{
alert ("Empty value", keys[i]);
exit();
}
value+="\r\n";
result+=value;
}
if (result=="") alert ("Empty result.", get_last_error_text());
string[] split=string_split (result, "\r\n", true);
split.sort_ascending();
result="";
l=split.length();
for (uint i=0; i<l; i++) result+=split[i]+"\r\n";
clipboard_copy_text (result);
}

string scramble()
{
const string key="Jedno pivooo, dvì pivaaa, tøi pivaaa, ètyøi pivaaa, pìt, šest, sedum, vosum piiiv, devìt, deset piiiv.";
string temp=string_reverse (key);
temp=string_replace (temp, "a", "\0", true);
string result;
uint8 l=temp.length();
for (uint i=0; i<l; i++) result+="" + character_to_ascii (temp[i]+46);
return result;
}