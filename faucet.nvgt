class faucets:entity
{
double[] amounts;
uint8 pipe, state;
character@ owner;
mug@ active_mug;
int spill;
bool said_running_out;

bool has_valid_pipe()
{
return pipe<amounts.length() and pipe<beers.length();
}

void reset()
{
entity::reset();
do
x=random (right_edge-faucet_distance, right_edge-step_size);
while (x == stairs);
y=0;
amounts.resize(0);
uint8 a=beers.length();
for (uint8 i=0; i<a; i++) amounts.insert_last (full_mug*beer_count);
pipe=0;
state=0;
@owner=null;
@active_mug=null;
spill=-1;
frames=-1;
said_running_out=false;
is_item=true;
}

void start (character@ handle)
{
if (state == 1 or @handle==null or handle.x!=x or handle.y!=y) return;
if (!has_valid_pipe()) return;
if (@handle.hand != null and handle.hand.kinds[0] > -1 and handle.hand.kinds[1] > -1 and handle.hand.kinds.find (pipe) == -1)
{
if (handle.is_player) error ("Do jednoho půllitru nemůžeš natočit víc než dva druhy pití.");
return;
}
if (amounts[pipe] <= 0) return;
@owner=handle;
if (@active_mug != @owner.hand) @active_mug=@owner.hand;
state=1;
owner.frozen=1;
owner.frames=0;
frames=-1;
check_pipe();
}

void stop (character@ handle, bool check_empty=true)
{
if (state ==0 or @handle==null or handle.x!=x or handle.y!=y) return;
handle.frozen=1;
handle.frames=0;
@owner=null;
state=0;
if (spill>-1 and things.sound_is_active (spill)) things.destroy_sound (spill);
spill=-1;
if (@active_mug != null and active_mug.pour > -1 and things.sound_is_playing (active_mug.pour)) things.pause_sound (active_mug.pour);
if (@active_mug!=null and active_mug.total>=poured_undermeasure) time_since_served=0;
@active_mug=null;
frames=-1;
if (check_empty and has_valid_pipe() and amounts[pipe] == 0) make_empty();
check_pipe();
said_running_out=false;
}

void state_running()
{
if (!has_valid_pipe())
{
stop (owner, false);
return;
}
if (amounts[pipe] == 0)
{
frames=-1;
make_empty();
stop (owner, false);
return;
}
bool lost_active_mug=@owner != null and @active_mug != null and (@owner.hand != @active_mug or owner.x!=x or owner.y!=y);
if (lost_active_mug)
{
if (@active_mug!=null and active_mug.pour>-1 and things.sound_is_playing (active_mug.pour)) things.pause_sound (active_mug.pour);
@active_mug=null;
}
amounts[pipe]--;
if (@owner!=null and (owner.x != x or owner.y != y or @active_mug == null or active_mug.total >= full_mug))
{
if (@active_mug != null and active_mug.pour > -1 and things.sound_is_playing (active_mug.pour))
{
if (active_mug.total < full_mug) things.pause_sound (active_mug.pour);
else
{
things.destroy_sound (active_mug.pour);
active_mug.pour=-1;
}
}
if (spill==-1)
{
frames=-1;
spill=play ("spill", true);
}
}
else
{
if (spill>-1 and things.sound_is_active (spill)) things.destroy_sound (spill);
spill=-1;
if (@active_mug != null)
{
if (active_mug.pour == -1) active_mug.pour=play ("pour", false, true);
else things.resume_sound (active_mug.pour);
active_mug.total++;
if (active_mug.amounts[0] == 0) active_mug.kinds[0]=pipe;
else if (active_mug.kinds.length()>1 and active_mug.amounts[1] == 0 and active_mug.kinds[0] != pipe and active_mug.kinds[1] != pipe) active_mug.kinds[1]=pipe;
int8 f=active_mug.kinds.find(pipe);
if (f > -1) active_mug.amounts[f]++;
}
}
if (@active_mug == null and @owner != null and @owner.hand != null and owner.x==x and owner.y==y) @active_mug=@owner.hand;
if (spill>-1 and things.sound_is_playing (spill) and (frames==0 or frames>fps*2) and amounts[pipe]>0) generate_mess (2);
if (frames>fps*2) frames=1;
check_pipe();
}

void act()
{
entity::act();
if (state == 1) state_running();
}

void make_empty()
{
if (!has_valid_pipe()) return;
uint8 l=barrels.length();
for (uint8 i=0; i<l; i++)
{
barrel@ b=barrels[i];
if (b.x==x and b.y==y and b.kind==pipe and b.amount==0) return;
}
barrel new;
new.x=x;
new.y=y;
new.kind=pipe;
new.amount=0;
new.voice="barrel";
new.start=random(0, 330);
new.falling=0;
new.slot=-1;
new.frames=0;
new.clean_frames=0;
new.is_player=false;
@new.owner=null;
new.is_item=true;
barrels.insert_last (new);
new.start_loop();
string rep, b=beers[pipe];
if (b=="Plzeň" or b=="Litovel" or b=="Polička" or b=="Stella" or b=="Kofola" or b=="Malinovka" or b=="Domácí limonáda" or b=="Voda" or b=="Žlutá" or b=="Citrónka" or b=="Zonka" or b=="Cola" or b=="Corona") rep="Došla ";
else if (b=="Svijany" or b=="Dačice") rep="Došly ";
else if (b=="Kafe") rep="Došlo ";
else rep="Došel ";
if (count_barrels(pipe) ==0) rep+="poslední ";
rep+=b+".";
say (rep, false);
frames=-1;
}

void check_pipe()
{
if (!has_valid_pipe()) return;
if (amounts[pipe]<=full_mug and amounts[pipe]>1 and !said_running_out)
{
say (beers[pipe]+" dochází.", false);
said_running_out=true;
}
}
}